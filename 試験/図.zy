// ============================================================
// 試験/図.zy — 試験のための文字の図
//
// 規則の試験は、局面が読めて初めて見直せる。だから試験の盤は
// 図として書き、ここで読み解く。
//   '.' 空 · 'X' 黒 · 'O' 白
// 図の第一行が盤の第一行（最上段）である。
//
// EN: 試験/図.zy — text diagrams for tests
//
// Rule tests are only reviewable if the position is readable, so
// test boards are written as diagrams and parsed here:
//   '.' empty · 'X' black · 'O' white
// Row 1 of the diagram is row 1 of the board (the top).
// ============================================================

# .試験_図 {

    #> { 読図, 描図 }

    読図(行配列) {
        局面 = []
        @ 行 : 行配列 {
            @ 文字 : 行 {
                局面 = 局面 $+ ?? 文字 {
                    'X' => 1
                    'O' => 2
                    _   => 0
                }
            }
        }
        <~ 局面
    }

    描図(局面, 路) {
        出力 = ""
        @ 行:1..路 {
            線 = ""
            @ 列:1..路 {
                値 = 局面[(行 - 1) * 路 + 列]
                字 = ?? 値 {
                    1 => "X"
                    2 => "O"
                    _ => "."
                }
                線 = "{線}{字}"
            }
            出力 = "{出力}{線}
"
        }
        <~ 出力
    }
}
