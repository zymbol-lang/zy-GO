// ============================================================
// 試験/思考試験.zy — 眼の判別と有用な手
//
// 眼の判別こそ、碁のエンジンを出鱈目な手の生成器から分ける規則で
// ある。眼が二つある群は取られないので、自分の眼を埋めるのが
// 正しいことは決してない。AI のどの層もこの二つの関数の上に載り、
// 打ち手に見せる助言も同じ場所に載っている。
//
//   zymbol run 試験/思考試験.zy
//
// EN: 試験/思考試験.zy — eye detection and useful moves
//
// Eye detection is the rule that separates a Go engine from a
// random move generator: a group with two eyes cannot be captured,
// so filling your own eye is never right. Every AI layer will rest
// on these two functions, and so does the player-facing hint.
//
//   zymbol run 試験/思考試験.zy
// ============================================================

<# ../核/盤 => 盤
<# ../核/規則 => 規則
<# ../核/思考 => 思
<# ./図 => 図

確認(名, 実際, 期待, 失敗<~) {
    ? 実際 == 期待 {
        >> "  ok    " 名 ¶
    } _ {
        >> "  FAIL  " 名 "   expected " 期待 ", got " 実際 ¶
        失敗 = 失敗 + 1
    }
}

失敗 = 0
>> "囲碁 — position reading tests" ¶
>> "" ¶

// ------------------------------------------------------------
>> "eyes — 眼" ¶

// A1 の隅の眼。直交する隣は両方とも黒で、盤上にある唯一の斜めも
// 黒である。
//
// EN: Corner eye at A1: both orthogonals are black and the single
// on-board diagonal is black too.
局面 = 図::読図([
    ".X...",
    "XX...",
    ".....",
    ".....",
    "....."
])
確認("corner eye", 思::眼(局面, 5, 1, 1), #1, 失敗<~)
確認("not an eye for the other colour", 思::眼(局面, 5, 1, 2), #0, 失敗<~)

// 同じ隅だが、斜めの B2 は白のもの。辺では盤上の斜めがすべて
// 自分のものでなければならないので、これは欠け眼である。
//
// EN: Same corner, but the diagonal B2 belongs to White: on an edge
// every on-board diagonal must be ours, so this is a false eye.
局面 = 図::読図([
    ".X...",
    "XO...",
    ".....",
    ".....",
    "....."
])
確認("corner with an enemy diagonal is not an eye", 思::眼(局面, 5, 1, 1), #0, 失敗<~)

// C3 の中央の眼。直交する隣が四つとも黒、斜めも四つとも黒。
// EN: Centre eye at C3: four orthogonals black, four diagonals
// black.
局面 = 図::読図([
    ".....",
    ".XXX.",
    ".X.X.",
    ".XXX.",
    "....."
])
確認("centre eye", 思::眼(局面, 5, 13, 1), #1, 失敗<~)

// 中央での敵の斜め一つは凌げる。それでも眼である。
// EN: One enemy diagonal in the centre is survivable — still an eye.
局面 = 図::読図([
    ".....",
    ".XXX.",
    ".X.X.",
    ".XXO.",
    "....."
])
確認("centre eye survives one enemy diagonal", 思::眼(局面, 5, 13, 1), #1, 失敗<~)

// 敵の斜めが二つなら欠け眼である。
// EN: Two enemy diagonals is a false eye.
局面 = 図::読図([
    ".....",
    ".OXX.",
    ".X.X.",
    ".XXO.",
    "....."
])
確認("two enemy diagonals — false eye", 思::眼(局面, 5, 13, 1), #0, 失敗<~)

// 直交する隣に穴があれば、斜めが何であろうと眼にはならない。
// EN: An orthogonal gap is never an eye, whatever the diagonals do.
局面 = 図::読図([
    ".....",
    ".XXX.",
    ".X..X",
    ".XXX.",
    "....."
])
確認("an open side is not an eye", 思::眼(局面, 5, 13, 1), #0, 失敗<~)

局面 = 図::読図([
    ".....",
    ".XXX.",
    ".XXX.",
    ".XXX.",
    "....."
])
確認("an occupied point is not an eye", 思::眼(局面, 5, 13, 1), #0, 失敗<~)

// ------------------------------------------------------------
>> "" ¶
>> "useful moves — 有用手" ¶

空盤 = 盤::新規(5)
確認("every point is useful on an empty board", (思::有用手(空盤, 5, 1, 0))$#, 25, 失敗<~)
確認("an empty board is not a dead end", 思::手詰まり(空盤, 5, 1, 0), #0, 失敗<~)

// 黒が A1 と C1 に眼を二つ持って盤を制している。この二点は黒に
// とって合法だが、それでも外さねばならない。埋めれば生きている
// 群が取られる群になるからである。
//
// EN: Black owns the board with two eyes at A1 and C1. Those two
// points are legal for Black and must still be excluded: filling
// them would turn a living group into a capturable one.
局面 = 図::読図([
    ".X.XX",
    "XXXXX",
    "XXXXX",
    "XXXXX",
    "XXXXX"
])
有 = 思::有用手(局面, 5, 1, 0)
確認("black will not fill its own eyes", 有$#, 0, 失敗<~)
確認("black has nothing left to play", 思::手詰まり(局面, 5, 1, 0), #1, 失敗<~)
確認("white cannot play there either — suicide", 思::手詰まり(局面, 5, 2, 0), #1, 失敗<~)

// ------------------------------------------------------------
>> "" ¶
>> "a real game — 129 moves, White to move" ¶

// 打ち手が実際に辿り着いた局面。白の十三子の群は G5 に眼が一つ、
// ダメも一つ。そこへ打てば自殺であり、盤上の他のどこにも合法手は
// 無い。助言が在るのはこのためである。白にはそれが見えず、規則も
// ひとりでに対局を終わらせはしない。
//
// EN: The position a player actually reached. White's 13-stone group
// has a single eye at G5 and one liberty: playing it is suicide,
// and there is no other legal move anywhere on the board. This is
// what the hint exists for — White cannot see it, and the rules
// will not end the game on their own.
局面 = 図::読図([
    ".XXXXXX.X",
    "XXXXXOOX.",
    ".X.XOOOXX",
    "XXXXXOOOO",
    ".X.XXO.OX",
    "XXXXXXOOX",
    ".X.XXXXXX",
    "XXOX.X.XX",
    ".XXXXXXXX"
])
群 = 盤::連(局面, 9, 42)
確認("white group is 13 stones", 群$#, 13, 失敗<~)
確認("with exactly one liberty", 盤::群ダメ数(局面, 9, 群), 1, 失敗<~)
確認("G5 is White's only eye", 思::眼(局面, 9, 43, 2), #1, 失敗<~)
確認("White has no useful move", (思::有用手(局面, 9, 2, 0))$#, 0, 失敗<~)
確認("White is at a dead end", 思::手詰まり(局面, 9, 2, 0), #1, 失敗<~)
確認("Black still has moves", (思::有用手(局面, 9, 1, 0))$#, 4, 失敗<~)

// ------------------------------------------------------------
>> "" ¶
>> "move selection — 着手選択" ¶

// 取れる石は取らねばならない。これが第二層であり、初級のエンジン
// でも間違えてはならない唯一のものである。
//
// EN: A capture that is there for the taking must be taken. This is
// layer 2, and it is the one a beginner engine cannot get wrong.
局面 = 図::読図([
    ".X...",
    "XOX..",
    ".....",
    ".....",
    "....."
])
確認("takes the free capture", 思::着手選択(局面, 5, 1, 2, 0, 0, 10), 12, 失敗<~)

// ダメが一つの連は逃げねばならず、出口は一つしかない。
// EN: A chain with one liberty must run, and there is only one way
// out.
局面 = 図::読図([
    ".....",
    "OXO..",
    ".O...",
    ".....",
    "....."
])
確認("the chain really is in atari", 盤::ダメ数(局面, 5, 7), 1, 失敗<~)

// 上級で訊く。級は「最善からどれだけ下まで選ばれうるか」であって、
// 中級の幅は 25 点ある。この局面では逃げが 67 点、白の一石に迫る手が
// 49 点で、その差は 18 — 中級の窓の中である。だから中級はときどき
// 迫るほうを選ぶ。それは評価の誤りではなく、級の定義そのものである。
// 上級の幅は 5 なので、選ばれるのは最善だけになり、この試験が訊いて
// いるもの — 評価が逃げを上に置くか — だけが残る。
//
// 追討の項が入るまで、その差は幅より広かった。試験が中級で通って
// いたのは、そういう偶然による。
//
// EN: Asked at advanced level. A level is "how far below the best a
// move may score and still be picked", and the intermediate window is
// 25 points. Here the escape scores 67 and closing in on White's lone
// stone scores 49 — 18 apart, inside that window, so intermediate will
// sometimes close in instead. That is not the evaluation being wrong;
// it is what the level means. The advanced window is 5, so only the
// best move survives and what this test asks — does the evaluation
// rank the escape first — is all that is left.
//
// Before the hunting term the gap was wider than the window, which is
// the accident that let this pass at intermediate.
確認("escapes through its only liberty", 思::着手選択(局面, 5, 1, 3, 0, 0, 10), 2, 失敗<~)

// 眼が二つあり、他にすることが無い。まともな手はパスだけであり、
// どちらの眼を埋めても生きている群を殺す。
//
// EN: Two eyes and nothing else to do: passing is the only sane
// move, and filling either eye would kill a living group.
局面 = 図::読図([
    ".X.XX",
    "XXXXX",
    "XXXXX",
    "XXXXX",
    "XXXXX"
])
確認("passes rather than fill its own eyes", 思::着手選択(局面, 5, 1, 3, 0, 0, 40), 0, 失敗<~)

// 空の盤では定石が選択を隅へ閉じ込める。エンジンが抱える唯一の
// 戦略の考えである。
//
// EN: On an empty board the opening book confines the choice to the
// corners — the one strategic idea the engine holds.
空 = 盤::新規(9)
角 = #1
@ _回:1..6 {
    点 = 思::着手選択(空, 9, 1, 2, 0, 0, 0)
    ? 思::布石点(9, 点) == #0 { 角 = #0 }
}
確認("opens in a corner, every time", 角, #1, 失敗<~)

// 何を選ぼうと合法でなければならない。下では自己対局を通して
// 丸ごと確かめるが、ここでは込み入った局面でも念を押しておく。
//
// EN: Whatever it picks must be legal — checked over a whole
// self-play game below, but asserted here on a crowded position
// too.
局面 = 図::読図([
    "XXOO.",
    "XOXO.",
    ".XOX.",
    "XXOOX",
    "OOXX."
])
点 = 思::着手選択(局面, 5, 1, 2, 0, 0, 20)
確認("its move on a crowded board is legal", 規則::判定(局面, 5, 点, 1, 0), 0, 失敗<~)

// ------------------------------------------------------------
>> "" ¶
>> "self-play — the engine against itself" ¶

局面 = 盤::新規(9)
手番 = 1
コウ = 0
パス = 0
手数 = 0
最終 = 0
不正 = 0

@ 手数 < 40 {
    ? パス >= 2 { @! }
    点 = 思::着手選択(局面, 9, 手番, 2, コウ, 最終, 手数)
    ? 点 == 0 {
        パス = パス + 1
        コウ = 0
        最終 = 0
    } _ {
        取 = 0
        コ = 0
        状 = 盤::着手(局面<~, 9, 点, 手番, 取<~, コ<~)
        ? 状 <> 0 { 不正 = 不正 + 1 }
        コウ = コ
        最終 = 点
        パス = 0
    }
    手番 = 盤::敵(手番)
    手数 = 手数 + 1
}

確認("never proposes an illegal move", 不正, 0, 失敗<~)
確認("the game actually progressed", 手数, 40, 失敗<~)
確認("and put stones on the board", (盤::石数(局面, 1)) > 5, #1, 失敗<~)

// ------------------------------------------------------------
>> "" ¶
>> "invasion guard — 侵入の見張り" ¶

// このエンジンは先を読まない。相手の地の真ん中に打った石は、
// 打った直後にはダメが三つあって自殺の検査を通り、数手のうちに
// 只で取られる。見張りはその読みの代わりであり、以下はそれが
// 実際に効いているかを訊く試験である。
//
// 単体の試験でこれを押さえるのは、一局まるごとでは押さえられない
// からである。種を決めて打たせても、この道を通る手はめったに
// 現れない。手で組んだ局面だけが、確かにそこを通す。
//
// EN: The engine does not read ahead: a stone played in the middle
// of the opponent's territory has three liberties the instant it
// lands, passes the suicide check, and is taken for free a few
// moves later. The guard stands in for that reading, and these
// tests ask whether it actually works.
//
// They are unit tests because a whole game cannot pin this down:
// with a fixed seed the path is almost never taken. Only a position
// built by hand goes through it for certain.

// 白の囲いの中。取りも、アタリも、繋ぎも、逃げも無い一手。
// EN: Inside White's enclosure. The move captures nothing, ataris
// nothing, connects nothing and escapes nothing.
局面 = 図::読図([
    ".........",
    ".........",
    ".........",
    ".........",
    ".........",
    "..OOOOO..",
    "..O...O..",
    "..O...O..",
    "..OOOOO.."
])
影響 = 思::影響図(局面, 9)
深点 = 盤::位置(9, 7, 5)
平点 = 盤::位置(9, 2, 2)
罠点 = 盤::位置(9, 7, 4)

確認("a move deep in enemy territory scores below zero",
     (思::評価(局面, 9, 深点, 1, 2, 0, 40, 影響, 0)) < 0, #1, 失敗<~)

// 見張りの外は触らない。遠い普通の点は、これまでどおり正の点数を
// もらう。減点がどこにでもかかるなら、それは見張りではなく雑音で
// ある。
//
// EN: Outside its reach nothing changes: an ordinary point far from
// the wall still scores positive. A penalty that lands everywhere is
// not a guard, it is noise.
確認("an ordinary point far from the wall is not penalised",
     (思::評価(局面, 9, 平点, 1, 2, 0, 40, 影響, 0)) > 0, #1, 失敗<~)

// 「敵の石に二つ以上触れている」を口実にしてはならない。深い侵入は
// 定義からして敵の石に囲まれているのだから、その条件はほとんど常に
// 成り立ち、見張りは捕まえるべき手の上で黙って無効になる。
// この点は白石二つに触れており、それでも咎められなければならない。
//
// EN: "It touches two or more enemy stones" must never be the
// excuse: a deep invasion is by definition surrounded by enemy
// stones, so the condition is nearly always true and the guard would
// turn itself off on exactly the moves it exists to catch. This
// point touches two white stones and must still be penalised.
確認("touching two enemy stones is not a tactical excuse",
     (思::評価(局面, 9, 罠点, 1, 2, 0, 40, 影響, 0)) < 0, #1, 失敗<~)

// 初級は第四層で止まる。見張りは第六層にあるので、初級の点数には
// 現れない。
//
// EN: Beginner stops at layer 4 and the guard is in layer 6, so it
// does not appear in a beginner's score.
確認("the guard is not applied at beginner level",
     思::評価(局面, 9, 深点, 1, 1, 0, 40, 影響, 0), 0, 失敗<~)

// 符号は色で変わる。同じ図の色を入れ替えれば、咎められるのは白の
// 一手である。符号を取り違えた見張りは、自陣の奥に打つのを咎めて
// 敵陣の奥を褒める。
//
// EN: The sign turns with the colour. Swap the colours in the same
// diagram and it is White's move that is penalised. A guard with the
// sign wrong punishes playing deep in your OWN sphere and rewards
// playing deep in the enemy's.
局面 = 図::読図([
    ".........",
    ".........",
    ".........",
    ".........",
    ".........",
    "..XXXXX..",
    "..X...X..",
    "..X...X..",
    "..XXXXX.."
])
影響 = 思::影響図(局面, 9)
確認("the same holds for White inside Black's wall",
     (思::評価(局面, 9, 深点, 2, 2, 0, 40, 影響, 0)) < 0, #1, 失敗<~)

// 口実があれば咎めない。この一手は同じくらい深いが、白石を取る。
// EN: A concrete reason excuses the depth: this move is just as deep
// and it captures a white stone.
局面 = 図::読図([
    ".........",
    "..OOOOO..",
    "..O.X.O..",
    "..OXO.O..",
    "..O.X.O..",
    "..OOOOO..",
    ".........",
    ".........",
    "........."
])
影響 = 思::影響図(局面, 9)
取点 = 盤::位置(9, 4, 6)
確認("the white stone really is in atari",
     盤::ダメ数(局面, 9, 盤::位置(9, 4, 5)), 1, 失敗<~)
確認("a capture is worth playing however deep it is",
     (思::評価(局面, 9, 取点, 1, 2, 0, 40, 影響, 0)) > 0, #1, 失敗<~)

// ------------------------------------------------------------
>> "" ¶
>> "hunting — 追討" ¶

// 侵入の見張りの裏側。あちらは「自分の石を只でやるな」と言い、
// こちらは「相手が只でくれた石は取れ」と言う。人が相手の engine が
// 負けるのは、たいていこの二つのどちらかを知らないからである。
//
// EN: The other side of the invasion guard. That one says do not give
// your stones away; this one says take the ones the opponent gave you.
// An engine that loses to a person usually fails one of the two.

// 白がいま自分の懐へ降りてきた。ダメは四つあって、まだ何も脅かして
// いない。それでも隣に打つ手のほうが、同じ地の遠い点より高くなければ
// ならない。追う値打ちがあるのは、追える間だけである。
//
// EN: White has just landed inside our own area with four liberties,
// threatening nothing yet. Playing beside it must still score higher
// than a far point in the same area: a group is worth hunting only
// while it can still be hunted.
局面 = 図::読図([
    ".........",
    ".XXXXXXX.",
    ".X.....X.",
    ".X.....X.",
    ".X..O..X.",
    ".X.....X.",
    ".X.....X.",
    ".XXXXXXX.",
    "........."
])
影響 = 思::影響図(局面, 9)
侵者 = 盤::位置(9, 5, 5)
寄る = 盤::位置(9, 4, 5)
遠い = 盤::位置(9, 3, 3)

確認("the invader really has four liberties", 盤::ダメ数(局面, 9, 侵者), 4, 失敗<~)
確認("approaching it beats playing far from it in the same area",
     (思::評価(局面, 9, 寄る, 1, 2, 侵者, 40, 影響, 0)) > (思::評価(局面, 9, 遠い, 1, 2, 侵者, 40, 影響, 0)),
     #1, 失敗<~)

// 値打ちで測る。ダメの数が同じ二つの連なら、大きいほうを脅かす手が
// 高い。石一つを脅す手と三つの連を脅す手が同じ点数だったのが、
// 直したかった振る舞いそのものである。
//
// EN: Weighed by what it is worth. Between two chains with the same
// liberties, threatening the larger one scores higher — a move that
// threatened one stone and a move that threatened three scoring the
// same is precisely the behaviour this replaced.
局面 = 図::読図([
    ".........",
    ".........",
    ".........",
    ".XXX...X.",
    ".OOO...O.",
    ".XXX...X.",
    ".........",
    ".........",
    "........."
])
影響 = 思::影響図(局面, 9)
大群 = 盤::位置(9, 5, 3)
小群 = 盤::位置(9, 5, 8)
大へ = 盤::位置(9, 5, 5)
小へ = 盤::位置(9, 5, 7)

確認("both chains are down to two liberties", 盤::ダメ数(局面, 9, 大群), 盤::ダメ数(局面, 9, 小群), 失敗<~)
確認("the big chain is three stones", (盤::連(局面, 9, 大群))$#, 3, 失敗<~)
確認("threatening three stones beats threatening one",
     (思::評価(局面, 9, 大へ, 1, 2, 0, 40, 影響, 0)) > (思::評価(局面, 9, 小へ, 1, 2, 0, 40, 影響, 0)),
     #1, 失敗<~)

// 取れるならば、脅すより取る。追討が取りより重くなったら、engine は
// 手中の鳥を逃がして藪を突くことになる。
//
// EN: Taking beats threatening. Were hunting ever to outweigh the
// capture itself, the engine would let the bird in hand go to beat
// the bush.
局面 = 図::読図([
    ".........",
    ".........",
    "..XXX....",
    "..XOX....",
    ".........",
    ".....X...",
    "....XO...",
    ".........",
    "........."
])
影響 = 思::影響図(局面, 9)
確認("the stone to be taken has one liberty", 盤::ダメ数(局面, 9, 盤::位置(9, 4, 4)), 1, 失敗<~)
確認("the other one still has two", 盤::ダメ数(局面, 9, 盤::位置(9, 7, 6)), 2, 失敗<~)
取る = 盤::位置(9, 5, 4)
迫る = 盤::位置(9, 7, 7)
確認("capturing outscores merely closing in",
