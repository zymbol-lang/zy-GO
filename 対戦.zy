// ============================================================
// 対戦.zy — 版と版を戦わせる
//
//   zymbol run --vm 対戦.zy [局数] [路] [甲] [乙] [級] [種]
//
//   局数  何局打つか            既定 50
//   路    9 · 13 · 19           既定 9
//   甲乙  版の番号（1, 2, …）   既定 1 と 2
//   級    1 初級 2 中級 3 上級   既定 2
//   種    親の種                既定 20260901
//
// 改良したと言うためには、改良する前と打ち合わせてみるしかない。
// この仕掛けは、凍らせた古い engine（版/思考v1.zy）と、いまの
// engine（核/思考.zy）に同じ盤を与え、色を一局ごとに入れ替えて
// 打たせ、どちらがどれだけ勝つかを数える。
//
// 色を入れ替えるのは、先手が得だからである。入れ替えなければ
// 測っているのは版の差ではなく先手の差になる。半分ずつ持てば
// その分は両方に等しく乗り、差し引きで消える。
//
// 種は引数である。時計から取らない。同じ引数からは同じ表が出る。
// 再演できない比較は、意見であって測定ではない。
//
// 時計はここに無い。速さを訊く道具は 棋戦.zy と 試験/自戦試験.zy
// であって、この仕掛けが答えるのは「どちらが強いか」だけである。
// 一つの計器に二つの問いを持たせると、どちらの答えも濁る。
//
// ── 版を足すには ────────────────────────────────────────────
//   1. いまの 核/思考.zy を 版/思考vN.zy として凍らせる
//      （名を # .版_思考vN に直し、import を ../核/ へ向ける）
//   2. 新しい engine を 核/思考.zy に書く
//   3. この file の 選ぶ() と 版名() に一行ずつ足す
//
// EN: 対戦.zy — version against version
//
//   zymbol run --vm 対戦.zy [games] [board] [a] [b] [level] [seed]
//
// The only way to say an engine got better is to play it against the
// engine it replaced. This hands the frozen old engine
// (版/思考v1.zy) and the current one (核/思考.zy) the same board,
// swaps colours every game, and counts.
//
// Colours are swapped because moving first is worth something: without
// the swap this would measure the first move, not the version. Split
// evenly, that advantage lands on both sides and cancels.
//
// The seed is an argument, not the clock — the same arguments produce
// the same table. A comparison that cannot be replayed is an opinion,
// not a measurement.
//
// There is no clock here. Speed is what 棋戦.zy and 試験/自戦試験.zy
// answer; this answers which engine plays better, and nothing else.
// An instrument asked two questions gives two muddy answers.
//
// ── to add a version ────────────────────────────────────────
//   1. freeze today's 核/思考.zy as 版/思考vN.zy (rename the module to
//      # .版_思考vN, point its imports at ../核/)
//   2. write the new engine in 核/思考.zy
//   3. add one line each to 選ぶ() and 版名() below
// ============================================================

<# ./核/盤 => 盤
<# ./核/計算 => 計算
<# ./版/思考v1 => 思1
<# ./版/思考v2 => 思2
<# ./核/思考 => 思3
<# ./表示/文字 => 文
<# ./言語/取次 => 言
<# ./言語/道具 => 道

訳(鍵) { <~ 道::語(鍵) }

// ── 版の表 ────────────────────────────────────────────────────
// EN: the version table

版数 := 3

版名(版) { <~ "v{版}" }

// 版の一行説明。表の下に出す。何が変わったのかを表の隣に書いて
// おかないと、半年後の自分に読めない。
//
// EN: One line per version, printed under the table. Without it the
// table is unreadable six months later.
版説明(版) {
    ? 版 == 1 { <~ 訳("対戦.版1") }
    ? 版 == 2 { <~ 訳("対戦.版2") }
    <~ 訳("対戦.版3")
}

選ぶ(版, 局面, 路, 色, 級, 性格, コウ点, 最終手, 手数, 種<~) {
    ? 版 == 1 { <~ 思1::選択(局面, 路, 色, 級, 性格, コウ点, 最終手, 手数, 種<~) }
    ? 版 == 2 { <~ 思2::選択(局面, 路, 色, 級, 性格, コウ点, 最終手, 手数, 種<~) }
    <~ 思3::選択(局面, 路, 色, 級, 性格, コウ点, 最終手, 手数, 種<~)
}

// ── 一局 ──────────────────────────────────────────────────────
// 結果[1] 勝色（0 は持碁）  [3] 手数     [5] 白の取った石
// 結果[2] 差                [4] 黒の取った石  [6] 安全弁で切れたら 1
//
// EN: one game
// 結果[1] winner (0 jigo)  [3] moves   [5] stones white took
// 結果[2] margin           [4] stones black took  [6] 1 if cut short

一局(路, 種初, 黒版, 白版, 級, 結果<~) {
    局面 = 盤::新規(路)
    種 = 種初
    手番 = 1
    コウ = 0
    最終 = 0
    パス = 0
    手数 = 0
    黒取 = 0
    白取 = 0
    上限 = 路 * 路 * 4

    @ 手数 < 上限 {
        ? パス >= 2 { @! }

        版 = 黒版
        ? 手番 == 2 { 版 = 白版 }

        点 = 選ぶ(版, 局面, 路, 手番, 級, 0, コウ, 最終, 手数, 種<~)
        手数 = 手数 + 1

        ? 点 == 0 {
            パス = パス + 1
            コウ = 0
            最終 = 0
        } _ {
            取 = 0
            コ = 0
            盤::着手(局面<~, 路, 点, 手番, 取<~, コ<~)
            ? 手番 == 1 {
                黒取 = 黒取 + 取
            } _ {
                白取 = 白取 + 取
            }
            コウ = コ
            最終 = 点
            パス = 0
        }
        手番 = 盤::敵(手番)
    }

    計 = 計算::目算(局面, 路, 6.5)
    結果[1]$~ 計算::勝色(計)
    結果[2]$~ 計算::差分(計)
    結果[3]$~ 手数
    結果[4]$~ 黒取
    結果[5]$~ 白取
    打切 = 0
    ? パス < 2 { 打切 = 1 }
    結果[6]$~ 打切
}

// ── 本体 ──────────────────────────────────────────────────────
// EN: main

>< 引数

局数 = 50
路 = 9
甲 = 2
乙 = 3
級 = 2
親種 = 20260901

? (引数$#) >= 1 { 局数 = #|引数[1]| }
? (引数$#) >= 2 { 路 = #|引数[2]| }
? (引数$#) >= 3 { 甲 = #|引数[3]| }
? (引数$#) >= 4 { 乙 = #|引数[4]| }
? (引数$#) >= 5 { 級 = #|引数[5]| }
? (引数$#) >= 6 { 親種 = #|引数[6]| }

? 甲 < 1 { 甲 = 1 }
? 甲 > 版数 { 甲 = 版数 }
? 乙 < 1 { 乙 = 1 }
? 乙 > 版数 { 乙 = 版数 }

言::設定("ja")

甲名 = 版名(甲)
乙名 = 版名(乙)
題 = 訳("対戦.表題")
>> "═══ " 題 " — " 甲名 " vs " 乙名 " · " 路 "×" 路 " · " 局数 " ═══" ¶
>> "" ¶

甲勝 = 0
乙勝 = 0
持碁 = 0
甲黒勝 = 0
甲白勝 = 0
乙黒勝 = 0
乙白勝 = 0
甲差計 = 0
乙差計 = 0
甲取 = 0
乙取 = 0
総手 = 0
打切数 = 0

種 = 親種
? 局数 >= 1 {
    @ 局:1..局数 {
        種 = 思3::乱数(種)
        局種 = 種

        // 一局ごとに色を入れ替える。奇数局は甲が黒。
        // EN: Colours swap every game; 甲 is black on the odd ones.
        黒版 = 甲
        白版 = 乙
        ? 局 % 2 == 0 {
            黒版 = 乙
            白版 = 甲
        }

        結果 = [0, 0, 0, 0, 0, 0]
        一局(路, 局種, 黒版, 白版, 級, 結果<~)

        勝 = 結果[1]
        差 = 結果[2]
        総手 = 総手 + 結果[3]
        打切数 = 打切数 + 結果[6]

        ? 黒版 == 甲 {
            甲取 = 甲取 + 結果[4]
            乙取 = 乙取 + 結果[5]
        } _ {
            乙取 = 乙取 + 結果[4]
            甲取 = 甲取 + 結果[5]
        }

        ? 勝 == 0 {
            持碁 = 持碁 + 1
        } _ {
            勝版 = 黒版
            ? 勝 == 2 { 勝版 = 白版 }
            ? 勝版 == 甲 {
                甲勝 = 甲勝 + 1
                甲差計 = 甲差計 + 差
                乙差計 = 乙差計 - 差
                ? 勝 == 1 { 甲黒勝 = 甲黒勝 + 1 } _ { 甲白勝 = 甲白勝 + 1 }
            } _ {
                乙勝 = 乙勝 + 1
                乙差計 = 乙差計 + 差
                甲差計 = 甲差計 - 差
                ? 勝 == 1 { 乙黒勝 = 乙黒勝 + 1 } _ { 乙白勝 = 乙白勝 + 1 }
            }
        }
    }
}

// ── 表 ────────────────────────────────────────────────────────
// EN: the table

欄版 = 文::右詰(訳("対戦.版"), 6)
欄勝 = 文::右詰(訳("対戦.勝ち"), 8)
欄黒 = 文::右詰(訳("対戦.黒番"), 8)
欄白 = 文::右詰(訳("対戦.白番"), 8)
欄差 = 文::右詰(訳("対戦.平均差"), 10)
欄取 = 文::右詰(訳("対戦.取石"), 10)
>> "  " 欄版 欄勝 欄黒 欄白 欄差 欄取 ¶

甲平均 = 0
乙平均 = 0
? 局数 >= 1 {
    甲平均 = 甲差計 / 局数
    乙平均 = 乙差計 / 局数
}

>> "  " 文::右詰(甲名, 6) 文::右詰("{甲勝}", 8) 文::右詰("{甲黒勝}", 8) 文::右詰("{甲白勝}", 8) 文::右詰("{甲平均}", 10) 文::右詰("{甲取}", 10) ¶
>> "  " 文::右詰(乙名, 6) 文::右詰("{乙勝}", 8) 文::右詰("{乙黒勝}", 8) 文::右詰("{乙白勝}", 8) 文::右詰("{乙平均}", 10) 文::右詰("{乙取}", 10) ¶
>> "" ¶

平均手 = 0
? 局数 >= 1 { 平均手 = 総手 / 局数 }
>> "  " 訳("対戦.持碁") " " 持碁 " · " 訳("対戦.平均手数") " " 平均手 " · " 訳("対戦.種") " " 親種 ¶
? 打切数 > 0 {
    >> "  " 訳("対戦.打切") " " 打切数 ¶
}
>> "" ¶
>> "  " 甲名 " — " 版説明(甲) ¶
>> "  " 乙名 " — " 版説明(乙) ¶
