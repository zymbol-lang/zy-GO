// ============================================================
// 対局.zy — 対局の采配
//
// 設定の画面、手番の輪、そして終局を受け持つ。ここが決めるのは
// 「何が起きるか」である。どう見えるかは 表示/描画.zy が決め、
// 何が合法かは 核/ が決める。打ち手が読む文字列をここで組み立て
// ることは無い。文言はすべて鍵を通して 言語/ から来る。
//
// 配列の並び（同じ表が 表示/描画.zy にもある）。
//   設定[1] 路   [2] 主題   [3] 級   [4] コミ   [5] 人色
//   状況[1] 手番 [2] 手数   [3] 黒取 [4] 白取   [5] 最終手
//        [6] コウ点         [7] 連続パス
//
// 人色 は人の打つ色である。0 なら人はいない — 観戦の様式で、
// 両方を AI に尋ね、盤の上でそれを見る。区画が「自分／機械」では
// なく色の名を出すのはそのためで、その形はもともと差し向かいの
// ために書かれたものである。
//
// 矢印の鍵は <<| から矢印の字そのもの — '↑' '↓' '←' '→' — として
// 届く。'U' 'D' 'L' 'R' ではない。GUIDE.md §3b はそう書いており、
// それは誤りである。serpiente/logica.zy は v0.0.5 から字で
// 合わせている。HALLAZGOS_ES.md HLZ-006 参照。
//
// EN: 対局.zy — match controller
//
// Owns the setup screen, the turn loop and the end of the game.
// It decides *what* happens; 表示/描画.zy decides how it looks and
// 核/ decides what is legal. Nothing here builds a string a player
// reads — every message comes from 言語/ through a key.
//
// Array layouts (see 表示/描画.zy for the same table):
//   設定[1] 路   [2] 主題   [3] 級   [4] コミ   [5] 人色
//   状況[1] 手番 [2] 手数   [3] 黒取 [4] 白取   [5] 最終手
//        [6] コウ点         [7] 連続パス
//
// 人色 is the colour the human plays; 0 means there is no human —
// the spectating mode, where both sides are asked of the AI and the
// game is watched on the board. That is why the panel names the
// colours instead of "you / machine" in that case: the shape was
// written for hot-seat and says exactly the right thing here.
//
// Arrow keys arrive from <<| as the arrow glyphs themselves —
// '↑' '↓' '←' '→' — not as 'U' 'D' 'L' 'R'. GUIDE.md §3b says
// otherwise and is wrong; serpiente/logica.zy has been matching
// on the glyphs since v0.0.5. See HALLAZGOS_ES.md HLZ-006.
// ============================================================

# 対局 {

    <# ./核/盤 => 盤
    <# ./核/規則 => 規則
    <# ./核/計算 => 計算
    <# ./核/思考 => 思
    <# ./表示/主題 => 主
    <# ./表示/描画 => 描
    <# ./表示/文字 => 文
    <# ./言語/取次 => 言

    #> { 開始, 観戦開始 }

    // 対局を始める。人は 手番 で選んだ色を持つ。
    // EN: Start a game; the human takes the side chosen under 手番.
    開始(言語コード) { <~ _起動(言語コード, 1) }

    // 観戦から始める。設定の画面は同じで、手番 だけが 観戦 に
    // 据えてある。入口を分けてあるのは、遊び場の script の一覧に
    // 出るのが入口だからで、そこに出ないものは無いのと同じである。
    // 画面の中で 手番 を戻せば、そのまま打つ対局になる。
    //
    // EN: Start in spectating mode. Same setup screen, with 手番 set
    // to 観戦. It is a separate entry because the entries are what
    // the playground's script list shows, and what is not in that
    // list may as well not exist. Move 手番 back on the screen and it
    // is an ordinary game again.
    観戦開始(言語コード) { <~ _起動(言語コード, 3) }

    _起動(言語コード, 手番既定) {
        言::設定(言語コード)
        (高, 幅) = >>?

        // 別画面に入る前に断る。描くには狭すぎる端末は、詫びるにも
        // 狭すぎるからである。
        //
        // EN: Refuse before entering the alternate screen: a terminal
        // too small to draw on is also too small to apologise on.
        ? 主::配置(9, 幅, 高) == 0 {
            _狭い(高, 幅)
            <~ 1
        }

        >>| {
            設定 = _設定画面(高, 幅, 手番既定)
            ? (設定$#) > 0 {
                ? 設定[5] == 0 {
                    _観戦(設定, 高, 幅)
                } _ {
                    _対局(設定, 高, 幅)
                }
            }
        }
        <~ 0
    }

    _狭い(高, 幅) {
        言葉 = 言::語("端末.狭い")
        要幅 = 主::最小幅(9)
        要高 = 主::最小高_下(9)
        >> 言葉 ¶
        >> "  " 幅 " × " 高 "  →  " 要幅 " × " 要高 ¶
    }

    // ---- 設定 -----------------------------------------------
    // EN: setup

    _可能路盤(高, 幅) {
        一覧 = []
        @ 路 : [9, 13, 19] {
            ? 主::配置(路, 幅, 高) > 0 { 一覧 = 一覧 $+ 路 }
        }
        <~ 一覧
    }

    _言語位置(一覧, コード) {
        総 = 一覧$#
        @ 添字:1..総 {
            ? 一覧[添字] == コード { <~ 添字 }
        }
        <~ 1
    }

    // 次の主題へ。対局と観戦の両方が同じ鍵で同じことをするので、
    // 二度書けば片方だけ直る日が来る。
    //
    // EN: Advance to the next theme. Both the played game and the
    // spectator do the same thing under the same key, and written
    // twice it is one edit away from doing two different things.
    _主題送り(設定<~) {
        一覧 = 主::主題一覧()
        総 = 一覧$#
        ? 総 >= 1 {
            現位 = 1
            @ 添字:1..総 {
                ? 一覧[添字] == 設定[2] { 現位 = 添字 }
            }
            設定[2]$~ 一覧[_回す(現位, 総, 1)]
        }
    }

    _回す(値, 総, 向き) {
        新 = 値 + 向き
        ? 新 < 1 { <~ 総 }
        ? 新 > 総 { <~ 1 }
        <~ 新
    }

    // 設定 の配列を返す。打ち手がやめたときは [] を返す。
    // EN: Returns the 設定 array, or [] when the player quits.
    _設定画面(高, 幅, 手番既定) {
        路一覧 = _可能路盤(高, 幅)
        コミ一覧 = [0, 5.5, 6, 6.5, 7, 7.5]
        主題一覧 = 主::主題一覧()
        言語一覧 = 言::言語一覧()
        // 黒が先に打つ。だから 白 を選ぶことは AI が口火を切ることを
        // 意味する。0 は観戦 — 人はどちらも打たない。
        //
        // EN: Black moves first, so choosing 白 means the AI opens.
        // 0 is spectating: the human plays neither side.
        手番一覧 = [1, 2, 0]

        路位 = 1
        級 = 2
        手番位 = 手番既定
        コミ位 = 4
        主題位 = 1
        言語位 = _言語位置(言語一覧, 言::現在())
        選 = 1
        行数 = 6

        欄 = 38
        上 = ##!((高 - 12) / 2 + 1)
        左 = ##!((幅 - 欄 - 2) / 2 + 1)
        ? 上 < 1 { 上 = 1 }
        ? 左 < 1 { 左 = 1 }

        >>!
        @ {
            名一覧 = [
                言::語("品書.路盤"),
                言::語("品書.棋力"),
                言::語("品書.手番"),
                言::語("品書.コミ"),
                言::語("品書.主題"),
                言::語("品書.言語")
            ]
            級札 = 言::語("棋力.{級}")
            手番札 = 言::語("色.黒")
            ? 手番一覧[手番位] == 2 { 手番札 = 言::語("色.白") }
            ? 手番一覧[手番位] == 0 { 手番札 = 言::語("品書.観戦") }
            主題札 = 言::語(主::主題鍵(主題一覧[主題位]))
            言札 = _言語名(言語一覧[言語位])
            // 補間が受け取るのは {識別子} だけなので、コミの値は
            // 文字にする前に名前へ束ねておく。
            //
            // EN: Interpolation takes {identifier} only, so the komi
            // value is bound before it can be turned into text.
            コミ値 = コミ一覧[コミ位]
            値一覧 = [
                言::路盤名(路一覧[路位]),
                級札,
                手番札,
                "{コミ値}",
                主題札,
                言札
            ]
            描::設定描画(上, 左, 欄, 選, 名一覧, 値一覧)

            <<| 打鍵
            ?? 打鍵 {
                '↑' => { 選 = _回す(選, 行数, -1) }
                '↓' => { 選 = _回す(選, 行数, 1) }
                '←' => { _設定変更(選, -1, 路位<~, 級<~, 手番位<~, コミ位<~, 主題位<~, 言語位<~, 路一覧, 手番一覧, コミ一覧, 主題一覧, 言語一覧) }
                '→' => { _設定変更(選, 1, 路位<~, 級<~, 手番位<~, コミ位<~, 主題位<~, 言語位<~, 路一覧, 手番一覧, コミ一覧, 主題一覧, 言語一覧) }
                '\n' => { @! }
                'q' || 'Q' => { <~ [] }
                _ => { }
            }
        }

        <~ [路一覧[路位], 主題一覧[主題位], 級, コミ一覧[コミ位], 手番一覧[手番位]]
    }

    // 添字は出力引数として渡り歩く。呼び出しの場に六つの枝を置く
    // 代わりに、一度の呼び出しで呼び手の状態が動くようにするため
    // である。
    //
    // EN: The indices travel as output parameters so the caller's
    // state moves with one call instead of six branches at the call
    // site.
    _設定変更(選, 向き, 路位<~, 級<~, 手番位<~, コミ位<~, 主題位<~, 言語位<~, 路一覧, 手番一覧, コミ一覧, 主題一覧, 言語一覧) {
        ? 選 == 1 { 路位 = _回す(路位, 路一覧$#, 向き) }
        ? 選 == 2 { 級 = _回す(級, 3, 向き) }
        ? 選 == 3 { 手番位 = _回す(手番位, 手番一覧$#, 向き) }
        ? 選 == 4 { コミ位 = _回す(コミ位, コミ一覧$#, 向き) }
        ? 選 == 5 { 主題位 = _回す(主題位, 主題一覧$#, 向き) }
        ? 選 == 6 {
            言語位 = _回す(言語位, 言語一覧$#, 向き)
            言::設定(言語一覧[言語位])
        }
    }

    // 言語の名は常にその言語自身で書く。한국어 を探している打ち手に
    // 「Korean」は見つけられない。
    //
    // EN: Language names are always written in their own language —
    // a player looking for 한국어 will not recognise "Korean".
    _言語名(コード) {
        前 = 言::現在()
        言::設定(コード)
        名 = 言::語("言語.名前")
        言::設定(前)
        <~ 名
    }

    // ---- 対局そのもの ---------------------------------------
    // EN: the match

    _複製況(状況) {
        写 = []
        @ 値 : 状況 { 写 = 写 $+ 値 }
        <~ 写
    }

    _対局(設定, 高, 幅) {
        路 = 設定[1]
        局面 = 盤::新規(路)
        状況 = [1, 0, 0, 0, 0, 0, 0]

        中央 = ##!((路 + 1) / 2)
        行 = 中央
        列 = 中央
        伝言 = ""

        履歴盤 = []
        履歴況 = []

        配置 = 主::配置(路, 幅, 高)
        上 = 1
        左 = 2
        側上 = 1
        側左 = ##!(左 + 主::区画幅(路) + 2)
        下行 = ##!(路 + 4)
        状行 = ##!(路 + 4)
        ? 配置 == 1 { 状行 = ##!(路 + 6) }

        >>!
        // 黒が口火を切る。人が白を選んだなら、AI が先に打つ。
        //
        // EN: Black opens. If the human chose White, the AI moves
        // first.
        ? 設定[5] == 2 {
            _全描画(局面, 設定, 状況, 配置, 上, 左, 側上, 側左, 下行, 状行, 行, 列, 言::語("報せ.考慮中"))
            _思考一手(局面<~, 設定, 状況<~, 伝言<~)
        }
        _全描画(局面, 設定, 状況, 配置, 上, 左, 側上, 側左, 下行, 状行, 行, 列, 伝言)

        @ {
            <<| 打鍵

            ?? 打鍵 {
                '↑' => {
                    ? 行 < 路 {
                        描::升描画(局面, 路, 設定[2], 行, 列, 上, 左, #0)
                        行 = 行 + 1
                        描::升描画(局面, 路, 設定[2], 行, 列, 上, 左, #1)
                    }
                }
                '↓' => {
                    ? 行 > 1 {
                        描::升描画(局面, 路, 設定[2], 行, 列, 上, 左, #0)
                        行 = 行 - 1
                        描::升描画(局面, 路, 設定[2], 行, 列, 上, 左, #1)
                    }
                }
                '←' => {
                    ? 列 > 1 {
                        描::升描画(局面, 路, 設定[2], 行, 列, 上, 左, #0)
                        列 = 列 - 1
                        描::升描画(局面, 路, 設定[2], 行, 列, 上, 左, #1)
                    }
                }
                '→' => {
                    ? 列 < 路 {
                        描::升描画(局面, 路, 設定[2], 行, 列, 上, 左, #0)
                        列 = 列 + 1
                        描::升描画(局面, 路, 設定[2], 行, 列, 上, 左, #1)
                    }
                }

                '\n' => {
                    点 = 盤::位置(路, 行, 列)
                    判 = 規則::判定(局面, 路, 点, 状況[1], 状況[6])
                    ? 判 <> 0 {
                        伝言 = 言::語(規則::理由鍵(判))
                    } _ {
                        履歴盤 = 履歴盤 $+ 盤::複製(局面)
                        履歴況 = 履歴況 $+ _複製況(状況)

                        取 = 0
                        コ = 0
                        盤::着手(局面<~, 路, 点, 状況[1], 取<~, コ<~)

                        ? 状況[1] == 1 {
                            状況[3]$~ (状況[3] + 取)
                        } _ {
                            状況[4]$~ (状況[4] + 取)
                        }
                        状況[2]$~ (状況[2] + 1)
                        状況[5]$~ 点
                        状況[6]$~ コ
                        状況[7]$~ 0
                        状況[1]$~ 盤::敵(状況[1])

                        伝言 = ""
                        ? 取 > 0 { 伝言 = 言::取石文(取) }

                        ? 状況[1] <> 設定[5] {
                            描::状態描画(言::語("報せ.考慮中"), 状行, 左, 路)
                            _思考一手(局面<~, 設定, 状況<~, 伝言<~)
                            ? 規則::終局(状況[7]) {
                                _終局(局面, 設定, 0, #0, 高, 幅)
                                @!
                            }
                        }
                    }
                    _全描画(局面, 設定, 状況, 配置, 上, 左, 側上, 側左, 下行, 状行, 行, 列, 伝言)
                }

                'p' || 'P' => {
                    履歴盤 = 履歴盤 $+ 盤::複製(局面)
                    履歴況 = 履歴況 $+ _複製況(状況)

                    伝言 = 言::語("報せ.自分パス")
                    状況[2]$~ (状況[2] + 1)
                    状況[5]$~ 0
                    状況[6]$~ 0
                    状況[7]$~ (状況[7] + 1)
                    状況[1]$~ 盤::敵(状況[1])

                    ? 規則::終局(状況[7]) {
                        _終局(局面, 設定, 0, #0, 高, 幅)
                        @!
                    }
                    ? 状況[1] <> 設定[5] {
                        描::状態描画(言::語("報せ.考慮中"), 状行, 左, 路)
                        _思考一手(局面<~, 設定, 状況<~, 伝言<~)
                        ? 規則::終局(状況[7]) {
                            _終局(局面, 設定, 0, #0, 高, 幅)
                            @!
                        }
                    }
                    _全描画(局面, 設定, 状況, 配置, 上, 左, 側上, 側左, 下行, 状行, 行, 列, 伝言)
                }

                'u' || 'U' => {
                    段数 = 履歴盤$#
                    ? 段数 == 0 {
                        伝言 = 言::語("報せ.待った不可")
                    } _ {
                        局面 = 盤::複製(履歴盤[段数])
                        状況 = _複製況(履歴況[段数])
                        ? 段数 == 1 {
                            履歴盤 = []
                            履歴況 = []
                        } _ {
                            履歴盤 = 履歴盤$[1..段数-1]
                            履歴況 = 履歴況$[1..段数-1]
                        }
                        伝言 = 言::語("報せ.待った")
                    }
                    _全描画(局面, 設定, 状況, 配置, 上, 左, 側上, 側左, 下行, 状行, 行, 列, 伝言)
                }

                't' || 'T' => {
                    _主題送り(設定<~)
                    >>!
                    _全描画(局面, 設定, 状況, 配置, 上, 左, 側上, 側左, 下行, 状行, 行, 列, 伝言)
                }

                'e' || 'E' => {
                    伝言 = 描::目算文(局面, 路, 設定[4], 設定[2], 状況[2])
                    描::状態描画(伝言, 状行, 左, 路)
                }

                '?' => {
                    描::助言描画(側上, 左)
                    <<| _待
                    >>!
                    _全描画(局面, 設定, 状況, 配置, 上, 左, 側上, 側左, 下行, 状行, 行, 列, 伝言)
                }

                'q' || 'Q' => {
                    // 投了。手番の側が投げるので、もう一方が中押しで
                    // 勝つ。目算はしない。
                    //
                    // EN: Resignation: the side to move gives up, so
                    // the other side wins by 中押し — no point count.
                    勝 = 盤::敵(状況[1])
                    _終局(局面, 設定, 勝, #1, 高, 幅)
                    @!
                }

                _ => { }
            }
        }
    }

    // AI の一手。人の一手の扱いをそのまま写している。エンジンは
    // どちらの側が尋ねているかを知らないし、気にもしない。
    //
    // EN: One AI move. Mirrors the human's move handling exactly —
    // the engine does not know or care which side is asking.
    _思考一手(局面<~, 設定, 状況<~, 伝言<~) {
        路 = 設定[1]
        級 = 設定[3]
        色 = 状況[1]

        点 = 思::着手選択(局面, 路, 色, 級, 状況[6], 状況[5], 状況[2])

        ? 点 == 0 {
            伝言 = 言::語("報せ.機械パス")
            状況[5]$~ 0
            状況[6]$~ 0
            状況[7]$~ (状況[7] + 1)
        } _ {
            取 = 0
            コ = 0
            盤::着手(局面<~, 路, 点, 色, 取<~, コ<~)
            ? 色 == 1 {
                状況[3]$~ (状況[3] + 取)
            } _ {
                状況[4]$~ (状況[4] + 取)
            }
            状況[5]$~ 点
            状況[6]$~ コ
            状況[7]$~ 0
            伝言 = ""
            ? 取 > 0 { 伝言 = 言::取石文(取) }
        }

        状況[2]$~ (状況[2] + 1)
        状況[1]$~ 盤::敵(色)
    }

    _全描画(局面, 設定, 状況, 配置, 上, 左, 側上, 側左, 下行, 状行, 行, 列, 伝言) {
        路 = 設定[1]
        主題 = 設定[2]
        描::盤描画(局面, 路, 主題, 上, 左)
        描::升描画(局面, 路, 主題, 行, 列, 上, 左, #1)
        ? 配置 == 2 {
            描::側面描画(局面, 設定, 状況, 側上, 側左)
        } _ {
            描::下面描画(局面, 設定, 状況, 下行, 左)
        }

        // 碁に自動の終局は無い。終わりはパスで打ち手が決める。
        // プログラムが代わりに決めることはしない。しかし、手番の側に
        // 非合法でも自分の眼を埋めるのでもない手がもう残っていない
        // ことは告げられる。初級者がまさに気づけないのがその瞬間で
        // ある。
        //
        // EN: Go has no automatic end: the players decide by passing.
        // The program will not decide it for them — but it can say
        // when the side to move has no move left that is not either
        // illegal or a self-filled eye, which is precisely the
        // moment a beginner does not recognise.
        文言 = 伝言
        ? 思::手詰まり(局面, 路, 状況[1], 状況[6]) {
            文言 = 言::語("報せ.打つ手無し")
        }
        描::状態描画(文言, 状行, 左, 路)
    }

    // ---- 観戦 -----------------------------------------------
    // 両方を AI が打ち、人はそれを見る。
    //
    // 対局の輪と別に書いてある。写し取ったからではなく、決めるものが
    // 違うからである。対局の輪では、次に何が起きるかは打鍵が決める。
    // ここでは対局が自分で進み、打鍵はその速さだけを決める。だから
    // 読み方も違う。打っている間は塞がらない読み（<<|?）で、休んで
    // いる間だけ塞がる読み（<<|）である。塞がる読みで回していたら
    // 一手ごとに打鍵を待つことになり、それは観戦ではない。
    //
    // 終わりは二段構えである。まず盤をそのまま残して結果を出すかと
    // 訊き、次に結果を出す。横並びの配置なら区画のあった所に出すので
    // 盤は消えない。碁の終わった盤は結果の半分であり、数だけ見せて
    // 盤を消してしまうのは、その半分を捨てることである。
    //
    // EN: spectating — both sides played by the AI, watched by a person.
    //
    // Written apart from the playing loop, not copied from it: what
    // decides the next step is different. There, a keystroke decides
    // what happens next; here the game advances on its own and a
    // keystroke only decides how fast. So the reading is different
    // too — non-blocking (<<|?) while it plays, blocking (<<|) only
    // while it is paused. Driven by the blocking read it would wait
    // for a key on every move, and that is not spectating.
    //
    // The ending comes in two steps: first the board is left exactly
    // as it stands and the status line offers the result, then the
    // result is drawn — over the panel, side by side with the board,
    // so the board never disappears. A finished board is half of the
    // result, and showing the numbers by erasing it throws that half
    // away.
    _観戦(設定, 高, 幅) {
        路 = 設定[1]
        局面 = 盤::新規(路)
        状況 = [1, 0, 0, 0, 0, 0, 0]
        伝言 = ""

        配置 = 主::配置(路, 幅, 高)
        上 = 1
        左 = 2
        側上 = 1
        側左 = ##!(左 + 主::区画幅(路) + 2)
        下行 = ##!(路 + 4)
        状行 = ##!(路 + 4)
        ? 配置 == 1 { 状行 = ##!(路 + 6) }

        停止 = #0
        中断 = #0

        >>!
        _観戦描画(局面, 設定, 状況, 配置, 上, 左, 側上, 側左, 下行, 状行, 停止)

        @ {
            ? 規則::終局(状況[7]) { @! }

            // 休んでいるなら打鍵を待ち、打っているなら覗くだけ。
            // EN: Wait for a key while paused; only glance while playing.
            打鍵 = '\0'
            ? 停止 {
                <<| 打鍵
            } _ {
                <<|? 打鍵
            }

            進む = #1
            ? 停止 { 進む = #0 }

            ?? 打鍵 {
                'q' || 'Q' => {
                    中断 = #1
                    @!
                }
                ' ' || 'p' || 'P' => {
                    停止 = !停止
                    進む = !停止
                }
                's' || 'S' => {
                    停止 = #1
                    進む = #1
                }
                't' || 'T' => {
                    _主題送り(設定<~)
                    >>!
                    進む = #0
                }
                '?' => {
                    描::観戦助言描画(側上, 左)
                    <<| _待
                    >>!
                    進む = #0
                }
                _ => { }
            }

            ? 進む {
                _思考一手(局面<~, 設定, 状況<~, 伝言<~)
            }
            _観戦描画(局面, 設定, 状況, 配置, 上, 左, 側上, 側左, 下行, 状行, 停止)
        }

        ? 中断 == #0 {
            _観戦終局(局面, 設定, 配置, 側上, 側左, 状行, 左, 高, 幅)
        }
    }

    // 対局の _全描画 との違いは二つだけ。合図の代わりに最後の一手を
    // 強調することと、状態の行が観戦の操作を出すことである。
    //
    // EN: Two differences from the playing 全描画: the last move is
    // highlighted instead of a cursor, and the status line carries
    // the spectating controls.
    _観戦描画(局面, 設定, 状況, 配置, 上, 左, 側上, 側左, 下行, 状行, 停止) {
        路 = 設定[1]
        主題 = 設定[2]
        描::盤描画(局面, 路, 主題, 上, 左)

        最終手 = 状況[5]
        ? 最終手 > 0 {
            行 = 盤::行番(路, 最終手)
            列 = 盤::列番(路, 最終手)
            描::升描画(局面, 路, 主題, 行, 列, 上, 左, #1)
        }

        ? 配置 == 2 {
            描::側面描画(局面, 設定, 状況, 側上, 側左)
        } _ {
            描::下面描画(局面, 設定, 状況, 下行, 左)
        }

        文言 = 言::語("報せ.観戦中")
        ? 停止 { 文言 = 言::語("報せ.休止") }
        描::状態描画(文言, 状行, 左, 路)
    }

    _観戦終局(局面, 設定, 配置, 側上, 側左, 状行, 左, 高, 幅) {
        路 = 設定[1]
        描::状態描画(言::語("報せ.結果へ"), 状行, 左, 路)
        <<| _待

        // 横並びなら盤を残す。縦積みでは枠付きの箱を置く余地が
        // 無いので、対局と同じ終わり方をする。
        //
        // EN: Side by side, the board stays. Stacked, there is no
        // room for a framed box, so it ends the way a played game does.
        ? 配置 == 2 {
            結果 = 計算::目算(局面, 路, 設定[4])
            勝色 = 計算::勝色(結果)
            差 = 計算::差分(結果)
            描::終局描画(結果, 設定, 勝色, 差, #0, 側上, 側左)
            <<| _待
        } _ {
            _終局(局面, 設定, 0, #0, 高, 幅)
        }
    }

    // 中押 が #1 なら対局は投了で終わっており、勝 が勝者である。
    // そうでなければ局面を数える。
    //
    // EN: 中押 #1 means the game ended by resignation and 勝 is the
    // winner; otherwise the position is counted.
    _終局(局面, 設定, 勝, 中押, 高, 幅) {
        路 = 設定[1]
        コミ = 設定[4]
        結果 = 計算::目算(局面, 路, コミ)
        差 = 0
        勝色 = 勝
        ? 中押 == #0 {
            勝色 = 計算::勝色(結果)
            差 = 計算::差分(結果)
        }

        欄 = 22
        上 = ##!((高 - 14) / 2 + 1)
        左 = ##!((幅 - 欄 - 2) / 2 + 1)
        ? 上 < 1 { 上 = 1 }
        ? 左 < 1 { 左 = 1 }

        >>!
        描::終局描画(結果, 設定, 勝色, 差, 中押, 上, 左)
        <<| _待
    }
}
