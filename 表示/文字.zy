// ============================================================
// 表示/文字.zy — text metrics for a multilingual TUI
//
// Terminal layout in 囲碁 is column-exact: the board grid, the
// side panel, and every framed screen must line up whether the
// interface language is Japanese, Korean, Chinese, English or
// Spanish. Grapheme count is NOT column count — CJK text and
// emoji occupy two columns each — so every width calculation in
// the program goes through 幅() here, never through $#.
//
// Since v0.0.8 this is a thin localized wrapper over std/term: the
// game speaks Japanese, the standard library speaks English. It
// used to carry a hand-maintained ~40-range East Asian width table
// (see IDEA-001 / HLZ in HALLAZGOS_ES.md); std/term::width now
// answers the column question from the unicode-width tables, which
// match that table exactly across every glyph 囲碁 draws.
// ============================================================

# .表示_文字 {

    <# std/term => 端

    #> {
        符号点
        幅
        右詰
        左詰
        中央
        切詰
    }

    // Unicode code point of a character. Since v0.0.8 ##! casts a
    // Char directly to its code point — the old route was inverting
    // a base literal (0d|c|) and stripping its "0d" prefix.
    符号点(c) { <~ ##!c }

    // Display width of a string, in terminal columns.
    幅(文字列) { <~ 端::width(文字列) }

    // Pad on the right to exactly 欄 columns. Longer strings are
    // returned untouched — truncation is 切詰's job.
    右詰(文字列, 欄) { <~ 端::pad_right(文字列, 欄) }

    // Pad on the left to exactly 欄 columns.
    左詰(文字列, 欄) { <~ 端::pad_left(文字列, 欄) }

    // Centre within 欄 columns; a spare column goes to the right.
    中央(文字列, 欄) { <~ 端::center(文字列, 欄) }

    // Truncate to at most 欄 columns, never splitting a wide glyph.
    切詰(文字列, 欄) { <~ 端::truncate(文字列, 欄) }
}
