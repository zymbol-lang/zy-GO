// ============================================================
// 表示/主題.zy — 石の主題と配置の算術
//
// 二桁の不変条件
// 盤の升は、どの主題でも、行の最後の列も含めて、端末の桁を
// ちょうど二つ占める。
//
//   空点            盤の字 + 継ぎ         1 + 1
//   空点・最終列    盤の字 + 空白         1 + 1
//   石・絵文字      ⚫ ⚪ 🌑 🌕（元より広い）  2
//   石・字          X / O + 継ぎ          1 + 1
//
// 最終列は見た目より重い。末尾の継ぎを落とすと、盤の字で
// 終わる行は石で終わる行より一桁狭くなり、右端の行番号が
// そこへ石が打たれるたびに揺れる。だから盤面は、その上に何が
// あろうと、常に 2 × 路 桁の幅を持つ。
//
// EN: 表示/主題.zy — stone themes and layout arithmetic
//
// THE TWO-COLUMN INVARIANT
// Every board cell occupies exactly two terminal columns, in
// every theme, including the last column of a row:
//
//   empty point      grid glyph + connector      1 + 1
//   empty, last col  grid glyph + space          1 + 1
//   stone, emoji     ⚫ ⚪ 🌑 🌕 (already wide)     2
//   stone, ASCII     X / O + connector           1 + 1
//
// The last column matters more than it looks. If the trailing
// connector were dropped, a row ending in a grid glyph would be
// one column narrower than a row ending in a stone, and the
// right-hand row label would jitter as stones are played there.
// So the grid is 2 × 路 columns wide, always, whatever is on it.
// ============================================================

# .表示_主題 {

    #> {
        主題一覧
        主題鍵
        石字
        升文字
        星点
        列名
        盤幅
        区画幅
        区画高
        側幅
        最小幅
        最小高_横
        最小高_下
        側面最小幅
        配置
        配置_不可
        配置_下
        配置_横
    }

    // 配置の様式。正の値だけ。モジュールの定数は裸の literal で
    // なければならない（HLZ-001）。
    //
    // EN: Layout modes. Positive values only — a module constant
    // must be a bare literal (HLZ-001).
    配置_不可 := 0
    配置_下   := 1
    配置_横   := 2

    側幅 := 24

    主題一覧() { <~ ["石", "月", "字"] }

    主題鍵(主題) {
        <~ ?? 主題 {
            "月" => "主題.月"
            "字" => "主題.字"
            _    => "主題.石"
        }
    }

    石字(主題, 色) {
        ?? 主題 {
            "月" => {
                ? 色 == 1 { <~ "🌑" }
                <~ "🌕"
            }
            "字" => {
                ? 色 == 1 { <~ "X" }
                <~ "O"
            }
            _ => {
                ? 色 == 1 { <~ "⚫" }
                <~ "⚪"
            }
        }
    }

    // 空点に描く盤の字。盤上の位置で決まる。
    // 行 はエンジン側の行（1 = 描かれた盤の最下段）。
    //
    // EN: Grid glyph for an empty point, by position on the board.
    // 行 is the engine row (1 = bottom of the drawn board).
    _枠(路, 行, 列) {
        ? 行 == 路 {
            ? 列 == 1 { <~ "┌" }
            ? 列 == 路 { <~ "┐" }
            <~ "┬"
        }
        ? 行 == 1 {
            ? 列 == 1 { <~ "└" }
            ? 列 == 路 { <~ "┘" }
            <~ "┴"
        }
        ? 列 == 1 { <~ "├" }
        ? 列 == 路 { <~ "┤" }
        ? 星点(路, 行, 列) { <~ "╋" }
        <~ "┼"
    }

    // 次の交点へ伸びる横線。最終列では次の交点が無いので空白。
    //
    // EN: The horizontal line to the next intersection — a space in
    // the last column, where there is no next intersection.
    _継(路, 列) {
        ? 列 == 路 { <~ " " }
        <~ "─"
    }

    // 一升。中身が何であれ、ちょうど二桁。
    // EN: One cell: exactly two columns, whatever it holds.
    升文字(主題, 値, 路, 行, 列) {
        継 = _継(路, 列)
        ? 値 == 0 {
            枠 = _枠(路, 行, 列)
            <~ "{枠}{継}"
        }
        石 = 石字(主題, 値)
        ? 主題 == "字" { <~ "{石}{継}" }
        <~ 石
    }

    // 星。盤の大きさごとに定める。
    // EN: 星 (hoshi) star points, by board size.
    星点(路, 行, 列) {
        ? 路 == 9 {
            ? 行 == 5 {
                ? 列 == 5 { <~ #1 }
            }
            ? 行 == 3 || 行 == 7 {
                ? 列 == 3 || 列 == 7 { <~ #1 }
            }
            <~ #0
        }
        ? 路 == 13 {
            ? 行 == 7 {
                ? 列 == 7 { <~ #1 }
            }
            ? 行 == 4 || 行 == 10 {
                ? 列 == 4 || 列 == 10 { <~ #1 }
            }
            <~ #0
        }
        ? 路 == 19 {
            ? 行 == 4 || 行 == 10 || 行 == 16 {
                ? 列 == 4 || 列 == 10 || 列 == 16 { <~ #1 }
            }
            <~ #0
        }
        <~ #0
    }

    // 列の記号。国際慣行に従い I を飛ばす。1 や J と読み違え
    // られないようにするためである。
    //
    // EN: Column letters, the international convention: I is skipped
    // so it cannot be misread as 1 or J.
    列名(列) {
        表 = "ABCDEFGHJKLMNOPQRST"
        <~ 表$[列..列]
    }

    // ---- 寸法 -----------------------------------------------
    // 左余白  5  （"  19 "）
    // 盤面    2 × 路
    // 行札    2  （空白 + 行番号）
    //
    // EN: geometry — gutter 5 ("  19 "), grid 2 × 路,
    // label 2 (space + row number)
    盤幅(路)   { <~ 2 * 路 }
    区画幅(路) { <~ 2 * 路 + 7 }
    区画高(路) { <~ 路 + 2 }

    最小幅(路) { <~ 2 * 路 + 9 }

    // 横並びには盤の塊と間隔と枠付きの区画が要る。区画そのものが
    // 10 行あるので、小さい盤では盤面ではなく区画が下限を決める。
    //
    // EN: Side-by-side needs the block, a gap and the boxed panel;
    // the panel itself is 10 rows, so short boards are bounded by
    // the panel rather than by the grid.
    側面最小幅(路) { <~ 2 * 路 + 33 }
    最小高_横(路) {
        ? 路 < 9 { <~ 13 }
        <~ 路 + 4
    }

    // 縦積みでは区画は詰めた一行に畳まれる。細長い端末に枠付きの
    // 箱を十行も置く余裕は無い。
    //
    // EN: Stacked, the panel collapses to a single dense line — a
    // tall narrow terminal cannot afford ten rows of framed box.
    最小高_下(路) { <~ 路 + 6 }

    配置(路, 幅, 高) {
        ? 幅 >= 側面最小幅(路) {
            ? 高 >= 最小高_横(路) { <~ 2 }
        }
        ? 幅 >= 最小幅(路) {
            ? 高 >= 最小高_下(路) { <~ 1 }
        }
        <~ 0
    }
}
