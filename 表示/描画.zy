// ============================================================
// 表示/描画.zy — 画面
//
// 行の文字列は純粋な関数（行文字・列見出・側面行）が組み立て、
// そのあとで初めて >>~ が位置を与える。この分け方は意図した
// ものである。>>| は TTY が無ければ動かないので、描くものは
// 管でつないだ試験にかけられない。しかし組み立てるものはかけ
// られる。試験/描画試験.zy はこのモジュールが出すすべての行の
// 桁の算術を確かめている。
//
// 対局.zy が組み立てる共有の配列の並び。
//
//   設定[1] 路      盤の大きさ        設定[4] コミ  コミ
//   設定[2] 主題    主題の符号        設定[5] 人色  人の色
//   設定[3] 級      AI の級 1..3
//
//   状況[1] 手番    手番の色          状況[5] 最終手  最後の点
//   状況[2] 手数    手の番号          状況[6] コウ点  コウの点
//   状況[3] 黒取    黒が取った数      状況[7] 連続パス パスの連続
//   状況[4] 白取    白が取った数
//
// Zymbol に構造体は無く、名前付きの組は不変なので、書き換え
// られる記録は並びを文書化した配列である。
//
// EN: 表示/描画.zy — screens
//
// Row strings are built by pure functions (行文字, 列見出, 側面行)
// and only then positioned with >>~. That split is deliberate:
// >>| refuses to run without a TTY, so anything that draws cannot
// be tested by piping — but everything that *composes* can, and
// 試験/描画試験.zy asserts the column arithmetic of every line
// this module emits.
//
// Shared array layouts, built by 対局.zy:
//
//   設定[1] 路      board size          設定[4] コミ  komi
//   設定[2] 主題    theme code          設定[5] 人色  human's colour
//   設定[3] 級      AI level 1..3
//
//   状況[1] 手番    side to move        状況[5] 最終手  last point
//   状況[2] 手数    move number         状況[6] コウ点  ko point
//   状況[3] 黒取    captured by black   状況[7] 連続パス passes
//   状況[4] 白取    captured by white
//
// Zymbol has no struct and named tuples are immutable, so a
// mutable record is an array with a documented layout.
// ============================================================

# .表示_描画 {

    <# ./主題 => 主
    <# ./文字 => 文
    <# ../核/盤 => 盤
    <# ../核/計算 => 計算
    <# ../言語/取次 => 言

    #> {
        列見出
        行文字
        行札
        枠上
        枠中
        枠下
        枠行
        側面行
        設定描画
        助言描画
        座標名
        盤描画
        升描画
        側面描画
        下面描画
        状態描画
        終局描画
        目算文
        消去

        色_枠
        色_札
        色_標
        色_縁
        色_文
    }

    色_枠 := 137
    色_札 := 245
    色_標 := 214
    色_縁 := 240
    色_文 := 252
    色_強 := 255

    消去() { >>! }

    // ---- 純粋な行の組み立て ---------------------------------

    // 盤の上に並ぶ列の記号。それぞれの記号は自分の升の左桁に座る
    // ので、見出しは盤面と同じく 2 × 路 の幅になる。
    //
    // EN: pure line builders
    // Column letters over the grid: each label sits in the left
    // column of its cell, so the header is 2 × 路 wide like the
    // grid itself.
    列見出(路) {
        線 = ""
        @ 列:1..路 {
            名 = 主::列名(列)
            線 = "{線}{名} "
        }
        <~ 線
    }

    // 盤の一行。中身が何であれ、ちょうど 2 × 路 桁。
    // EN: One grid row, exactly 2 × 路 columns whatever it holds.
    行文字(局面, 路, 主題, 行) {
        線 = ""
        @ 列:1..路 {
            値 = 局面[盤::位置(路, 行, 列)]
            升 = 主::升文字(主題, 値, 路, 行, 列)
            線 = "{線}{升}"
        }
        <~ 線
    }

    // 右へ寄せた行番号、二桁。
    // EN: Right-aligned row number, two columns.
    行札(行) { <~ 文::左詰("{行}", 2) }

    // 枠の部品。内側の幅を引数に取る。対局の中で枠に囲まれたものは
    // すべてこの四つから作られるので、箱が自分の幅について自分と
    // 食い違うことは決して起きない。
    //
    // EN: Frame pieces, parametric in the interior width. Everything
    // framed in the game is built from these four, so a box can
    // never disagree with itself about how wide it is.
    枠上(欄) {
        線 = "─" $* 欄
        <~ "╭{線}╮"
    }
    枠中(欄) {
        線 = "─" $* 欄
        <~ "├{線}┤"
    }
    枠下(欄) {
        線 = "─" $* 欄
        <~ "╰{線}╯"
    }
    枠行(内容, 欄) {
        中 = 文::右詰(文::切詰(内容, 欄), 欄)
        <~ "│{中}│"
    }

    側内幅() { <~ 22 }
    側面行(内容) { <~ 枠行(内容, 側内幅()) }

    _横線(左字, 右字) {
        線 = "─" $* 側内幅()
        <~ "{左字}{線}{右字}"
    }

    // ---- 設定の画面 -----------------------------------------
    // 名一覧 と 値一覧 は、訳し終えた文字列の対になる配列である。
    // このモジュールは設定の呼び名を決して自分で決めない。
    //
    // EN: setup screen
    // 名一覧 and 値一覧 are parallel arrays of already-translated
    // strings: this module never decides what a setting is called.
    _選択行(選中, 名, 値) {
        印 = "  "
        ? 選中 { 印 = "► " }
        名札 = 文::右詰(名, 12)
        値札 = 文::中央(値, 14)
        <~ " {印}{名札}‹{値札}›"
    }

    設定描画(上, 左, 欄, 選, 名一覧, 値一覧) {
        行 = 上
        >>~ (行, 左, 0, 色_縁) > 枠上(欄)

        行 = ##!(行 + 1)
        題 = 文::中央(言::語("品書.表題"), 欄)
        >>~ (行, 左, 1, 色_強) > "│{題}│"

        行 = ##!(行 + 1)
        版 = 文::中央("Zymbol v0.0.8", 欄)
        >>~ (行, 左, 0, 色_札) > "│{版}│"

        行 = ##!(行 + 1)
        >>~ (行, 左, 0, 色_縁) > 枠中(欄)

        総 = 名一覧$#
        @ 添字:1..総 {
            行 = ##!(行 + 1)
            選中 = 添字 == 選
            線 = _選択行(選中, 名一覧[添字], 値一覧[添字])
            色 = 色_文
            ? 選中 { 色 = 色_強 }
            >>~ (行, 左, 0, 色) > 枠行(線, 欄)
        }

        行 = ##!(行 + 1)
        >>~ (行, 左, 0, 色_縁) > 枠中(欄)

        行 = ##!(行 + 1)
        案内 = 文::中央(言::語("品書.案内"), 欄)
        >>~ (行, 左, 0, 色_札) > "│{案内}│"

        行 = ##!(行 + 1)
        >>~ (行, 左, 0, 色_縁) > 枠下(欄)
    }

    // ---- 操作の助言 -----------------------------------------
    // EN: help overlay
    _助言行(鍵, 操作) {
        名 = 言::語(鍵)
        札 = 文::右詰(操作, 10)
        <~ " {札}{名}"
    }

    助言描画(上, 左) {
        欄 = 30
        行 = 上
        >>~ (行, 左, 0, 色_縁) > 枠上(欄)

        行 = ##!(行 + 1)
        題 = 文::中央(言::語("操作.表題"), 欄)
        >>~ (行, 左, 1, 色_強) > "│{題}│"

        行 = ##!(行 + 1)
        >>~ (行, 左, 0, 色_縁) > 枠中(欄)

        鍵一覧 = ["操作.移動", "操作.着手", "操作.パス", "操作.待った", "操作.目算", "操作.主題切替", "操作.投了"]
        操作一覧 = ["↑↓←→", "↵", "p", "u", "e", "t", "q"]
        総 = 鍵一覧$#
        @ 添字:1..総 {
            行 = ##!(行 + 1)
            >>~ (行, 左, 0, 色_文) > 枠行(_助言行(鍵一覧[添字], 操作一覧[添字]), 欄)
        }

        行 = ##!(行 + 1)
        >>~ (行, 左, 0, 色_縁) > 枠下(欄)
    }

    // ---- 位置を与えて描く -----------------------------------
    // 上 は列見出しの画面上の行、左 は左余白の始まる画面上の桁。
    //
    // EN: positioned drawing
    // 上 is the screen row of the column header, 左 the screen
    // column where the gutter starts.

    _画面行(上, 路, 行) { <~ ##!(上 + 1 + (路 - 行)) }
    _画面列(左, 列)     { <~ ##!(左 + 5 + (列 - 1) * 2) }

    盤描画(局面, 路, 主題, 上, 左) {
        見出 = 列見出(路)
        起列 = ##!(左 + 5)

        >>~ (上, 起列, 0, 色_札) > 見出
        下 = ##!(上 + 路 + 1)
        >>~ (下, 起列, 0, 色_札) > 見出

        @ 行:1..路 {
            画行 = _画面行(上, 路, 行)
            札 = 行札(行)
            線 = 行文字(局面, 路, 主題, 行)
            右列 = ##!(左 + 5 + 2 * 路)

            >>~ (画行, ##!(左 + 2), 0, 色_札) > 札
            >>~ (画行, 起列, 0, 色_枠) > 線
            >>~ (画行, 右列, 0, 色_札) > 札
        }
    }

    // 一升だけ描き直す。強調 が #1 のときは印として際立たせる。
    // 空点は ＋ になるので、背景色の扱いが弱い端末でも印は見える。
    //
    // EN: Redraw a single cell. 強調 #1 highlights it as the cursor:
    // an empty point becomes ＋ so the cursor stays visible even
    // where background colour is poorly supported.
    升描画(局面, 路, 主題, 行, 列, 上, 左, 強調) {
        値 = 局面[盤::位置(路, 行, 列)]
        画行 = _画面行(上, 路, 行)
        画列 = _画面列(左, 列)

        ? 強調 {
            ? 値 == 0 {
                >>~ (画行, 画列, 0, 色_強, 色_標) > "＋"
            } _ {
                石 = 主::石字(主題, 値)
                >>~ (画行, 画列, 0, 色_強, 色_標) > 石
            }
        } _ {
            升 = 主::升文字(主題, 値, 路, 行, 列)
            >>~ (画行, 画列, 0, 色_枠) > 升
        }
    }

    // 手番が誰か。両者とも人なら色を、片方が人でなければ
    // 打ち手か AI かを示す。
    //
    // EN: Who is to move: the colour when both sides are human, the
    // player or the AI when one of them is not.
    _手番名(手番, 人色) {
        ? 人色 == 0 {
            ? 手番 == 1 { <~ 言::語("色.黒") }
            <~ 言::語("色.白")
        }
        ? 手番 == 人色 { <~ 言::語("側.自分") }
        <~ 言::語("側.機械")
    }

    側面描画(局面, 設定, 状況, 上, 左) {
        路 = 設定[1]
        主題 = 設定[2]
        級 = 設定[3]
        コミ = 設定[4]
        人色 = 設定[5]

        手番 = 状況[1]
        手数 = 状況[2]
        黒取 = 状況[3]
        白取 = 状況[4]
        最終手 = 状況[5]

        盤名 = 言::路盤名(路)
        黒 = 主::石字(主題, 1)
        白 = 主::石字(主題, 2)

        // AI の級を告げるのは、それを当てはめる AI がいるときだけ。
        // 人どうしの対局では盤の名前だけが立つ。
        //
        // EN: The AI level is only announced when there is an AI to
        // apply it to; in hot-seat the board name stands alone.
        題 = 盤名
        ? 人色 <> 0 {
            級名 = 言::語("棋力.{級}")
            題 = "{盤名} · {級名}"
        }

        行 = 上
        >>~ (行, 左, 0, 色_縁) > _横線("╭", "╮")

        行 = ##!(行 + 1)
        >>~ (行, 左, 0, 色_文) > 側面行(" {題}")

        行 = ##!(行 + 1)
        >>~ (行, 左, 0, 色_縁) > _横線("├", "┤")

        // 並置がその場で各行を組む。区画の見出しは、補間のためだけの
        // 中間の変数をもう必要としない。
        //
        // EN: Juxtaposition composes each row inline: the panel
        // labels no longer need an intermediate variable each just
        // to interpolate.
        行 = ##!(行 + 1)
        >>~ (行, 左, 0, 色_文) > 側面行(" " 文::右詰(言::語("区画.手番"), 10) 主::石字(主題, 手番) " " _手番名(手番, 人色))

        行 = ##!(行 + 1)
        >>~ (行, 左, 0, 色_文) > 側面行(" " 文::右詰(言::語("区画.手数"), 10) 手数)

        行 = ##!(行 + 1)
        >>~ (行, 左, 0, 色_文) > 側面行(" " 文::右詰(言::語("区画.アゲハマ"), 10) 黒 黒取 "  " 白 白取)

        行 = ##!(行 + 1)
        >>~ (行, 左, 0, 色_文) > 側面行(" " 文::右詰(言::語("区画.コミ"), 10) コミ)

        行 = ##!(行 + 1)
        >>~ (行, 左, 0, 色_文) > 側面行(" " 文::右詰(言::語("区画.最終手"), 10) 座標名(路, 最終手))

        行 = ##!(行 + 1)
        >>~ (行, 左, 0, 色_文) > 側面行(" " 文::右詰(言::語("区画.目算"), 10) 目算文(局面, 路, コミ, 主題, 手数))

        行 = ##!(行 + 1)
        >>~ (行, 左, 0, 色_縁) > _横線("╰", "╯")
    }

    // 対局中の形勢。「⚫ +2.5」、または互角なら等号。今の局面から
    // 算出するので、境界が締まるにつれて揺れる。それは欠陥ではなく
    // 正直な振る舞いである。
    // 空白なのは両者が一手ずつ打つまでの間だけ。黒の第一着のあとの
    // 中国式の計算は黒に八十一目すべてを渡して「+74.5」と告げる。
    // 算術としては正しく、何も語っていない。盤上の石の数ではなく
    // 手数で見分けているのは大事なところである。大差の対局では
    // 終盤に一方の色が盤から消えることがあり、打ち手が差を最も
    // 見たいのはまさにそのときだからである。
    //
    // EN: Live estimate: "⚫ +2.5", or a level sign when the count is
    // even. Computed from the current position, so it swings as
    // the boundaries close — that is the honest behaviour, not a
    // defect.
    // Blank only until both sides have moved once:
    // after Black's first stone, area scoring hands Black all 81
    // points and reports "+74.5", which is arithmetically right and
    // says nothing. Keying this off the move count rather than off
    // the stones on the board matters — a colour can be wiped from
    // the board late in a lopsided game, and that is exactly when
    // the player most needs to see the margin.
    目算文(局面, 路, コミ, 主題, 手数) {
        ? 手数 < 2 { <~ "—" }
        結果 = 計算::目算(局面, 路, コミ)
        勝 = 計算::勝色(結果)
        ? 勝 == 0 { <~ "=" }
        差 = 計算::差分(結果)
        石 = 主::石字(主題, 勝)
        <~ "{石} +{差}"
    }

    // 縦積みの配置では、箱の代わりに詰めた一行を置く。
    // EN: The stacked layout gets one dense line instead of a box.
    下面描画(局面, 設定, 状況, 行, 左) {
        路 = 設定[1]
        主題 = 設定[2]
        コミ = 設定[4]
        人色 = 設定[5]
        手番 = 状況[1]
        手数 = 状況[2]
        黒取 = 状況[3]
        白取 = 状況[4]
        最終手 = 状況[5]

        手石 = 主::石字(主題, 手番)
        誰 = _手番名(手番, 人色)
        黒 = 主::石字(主題, 1)
        白 = 主::石字(主題, 2)
        座 = 座標名(路, 最終手)
        評 = 目算文(局面, 路, コミ, 主題, 手数)

        線 = "{手石} {誰}   {手数}   {黒}{黒取} {白}{白取}   {座}   {評}"
        欄 = 主::区画幅(路)
        >>~ (行, 左, 0, 色_文) > 文::右詰(文::切詰(線, 欄), 欄)
    }

    // 点なら「D4」、無ければ「—」。行は下から数える。打ち手が
    // 盤を読むのと同じ向きである。
    //
    // EN: "D4" for a point, "—" for none. Rows count up from the
    // bottom, the way a player reads the board.
    座標名(路, 点) {
        ? 点 < 1 { <~ "—" }
        行 = ##!((点 - 1) / 路 + 1)
        列 = ##!(点 - (行 - 1) * 路)
        名 = 主::列名(列)
        <~ "{名}{行}"
    }

    // 盤の下の状態の行。塊の幅いっぱいまで詰めて消すので、長い
    // 文言が尾を残すことは決して無い。
    //
    // EN: The status line under the board. Cleared by padding to the
    // full block width, so a long message never leaves a tail.
    状態描画(文言, 行, 左, 路) {
        欄 = 主::区画幅(路)
        線 = 文::右詰(文言, 欄)
        >>~ (行, 左, 0, 色_文) > 線
    }

    // 補間が受け取るのは {識別子} だけである。欄の参照も添字も
    // 通らないので、値はすべて先に局所の名前へ束ねる。
    //
    // EN: Interpolation accepts {identifier} only — no field access,
    // no indexing — so every value is bound to a local first.
    終局描画(結果, 設定, 勝, 差, 中押, 上, 左) {
        主題 = 設定[2]
        コミ = 設定[4]
        黒 = 主::石字(主題, 1)
        白 = 主::石字(主題, 2)

        黒石 = 結果.黒石
        白石 = 結果.白石
        黒地 = 結果.黒地
        白地 = 結果.白地
        黒合 = 結果.黒合計
        白合 = 結果.白合計

        行 = 上
        >>~ (行, 左, 0, 色_縁) > _横線("╭", "╮")

        行 = ##!(行 + 1)
        題 = 文::中央(言::語("終局.表題"), 側内幅())
        >>~ (行, 左, 1, 色_強) > "│{題}│"

        行 = ##!(行 + 1)
        >>~ (行, 左, 0, 色_縁) > _横線("├", "┤")

        頭 = 文::右詰("", 10)
        黒札 = 文::右詰(黒, 6)
        行 = ##!(行 + 1)
        >>~ (行, 左, 0, 色_文) > 側面行(" {頭}{黒札}{白}")

        行 = ##!(行 + 1)
        名_石 = 文::右詰(言::語("終局.石"), 10)
        黒石札 = 文::右詰("{黒石}", 6)
        >>~ (行, 左, 0, 色_文) > 側面行(" {名_石}{黒石札}{白石}")

        行 = ##!(行 + 1)
        名_地 = 文::右詰(言::語("終局.地"), 10)
        黒地札 = 文::右詰("{黒地}", 6)
        >>~ (行, 左, 0, 色_文) > 側面行(" {名_地}{黒地札}{白地}")

        行 = ##!(行 + 1)
        名_コミ = 文::右詰(言::語("終局.コミ"), 10)
        空欄 = 文::右詰("—", 6)
        >>~ (行, 左, 0, 色_文) > 側面行(" {名_コミ}{空欄}{コミ}")

        行 = ##!(行 + 1)
        >>~ (行, 左, 0, 色_縁) > _横線("├", "┤")

        行 = ##!(行 + 1)
        名_合 = 文::右詰(言::語("終局.合計"), 10)
        黒合札 = 文::右詰("{黒合}", 6)
        >>~ (行, 左, 1, 色_強) > 側面行(" {名_合}{黒合札}{白合}")

        行 = ##!(行 + 1)
        >>~ (行, 左, 0, 色_縁) > _横線("├", "┤")

        行 = ##!(行 + 1)
        文言 = 言::結果文(勝, 差, 中押)
        判 = 文::中央(文::切詰(文言, 側内幅()), 側内幅())
        >>~ (行, 左, 1, 色_強) > "│{判}│"

        行 = ##!(行 + 1)
        >>~ (行, 左, 0, 色_縁) > _横線("╰", "╯")
    }
}
