// ============================================================
// 核/規則.zy — 合法性と終局
//
// 盤.zy は石の振る舞いを知り、規則.zy はどの手が打てるかを知る。
// この分け方はコウのために要る。コウ禁止は今の局面についての
// 事実ではなく、対局の履歴についての事実なので、盤の側には
// 置けないのである。
//
// 判定() は呼び手の盤を決して書き換えない。写しの上で打つ。
// AI の輪の中で最も多く呼ばれる関数なので、一手が重いと
// 感じたら最初に見る場所でもある。
//
// EN: 核/規則.zy — legality and end of game
//
// 盤.zy knows how stones behave; 規則.zy knows which moves a
// player is allowed to make. The split matters for ko: a ko ban
// is a fact about the history of the game, not about the current
// position, so it cannot live in the board module.
//
// 判定() never mutates the caller's board — it plays on a copy.
// It is the most-called function in the AI loop, so it is also
// the first place to look when a turn feels slow.
// ============================================================

# .核_規則 {

    <# ./盤 => 盤

    #> {
        可
        禁_占有
        禁_自殺
        禁_コウ
        判定
        合法
        着手可能
        終局
        理由鍵
    }

    // 正の符号。盤.zy の 着手() に合わせてある。
    // EN: Positive codes, matching 盤.zy's 着手().
    可       := 0
    禁_占有  := 1
    禁_自殺  := 2
    禁_コウ  := 3

    // 合法なら 0、そうでなければ理由を返す。
    //
    // 盤には触れない。写しも取らない。自殺かどうかは、打った後の
    // 盤を作らなくても、隣の三つの事実だけで決まるからである。
    //
    //   · 隣に空点が一つでもあれば、その一手はダメを持つ
    //   · 隣の敵の連がダメ一つなら、その一手が取る（唯一のダメが
    //     この点なのだから、必ず取れる）
    //   · 隣の味方の連がダメ二つ以上なら、繋いだ後も一つ残る
    //
    // どれにも当たらなければ、隣はすべて塞がり、取れる敵もおらず、
    // 味方の連はどれもこの点だけがダメである。打てば全体のダメが
    // 尽きる。すなわち自殺。
    //
    // これが要るのは費用のためである。この関数は AI の輪の中で
    // 最も多く呼ばれ、有用手() は毎手すべての空点に対してこれを
    // 呼ぶ。ほとんどの点は最初の走査 — 隣に空点あり — で答えが
    // 出て、塗り潰しは一度も走らない。
    //
    // EN: 0 when the move is legal, otherwise the reason.
    //
    // The board is never touched and never copied. Whether a move is
    // suicide follows from three facts about its neighbours, without
    // building the position it would produce:
    //
    //   · one empty neighbour and the move has a liberty
    //   · an enemy chain next to it with exactly one liberty is
    //     captured (that liberty can only be this point)
    //   · a friendly chain next to it with two or more liberties
    //     still has one left after connecting
    //
    // If none holds, every neighbour is occupied, nothing is
    // captured, and every friendly neighbour chain has this point as
    // its only liberty — so playing there fills the last one. Suicide.
    //
    // This exists for cost. It is the most-called function in the AI
    // loop — 有用手() asks it about every empty point, every turn —
    // and most points are answered by the first scan, one empty
    // neighbour, without a flood fill ever running.
    判定(局面, 路, 起点, 色, コウ点) {
        ? 起点 < 1 { <~ 1 }
        ? 起点 > 路 * 路 { <~ 1 }
        ? 局面[起点] <> 0 { <~ 1 }
        ? 起点 == コウ点 { <~ 3 }

        隣接 = 盤::隣(路, 起点)
        @ 隣点 : 隣接 {
            ? 局面[隣点] == 0 { <~ 0 }
        }

        敵色 = 盤::敵(色)
        @ 隣点 : 隣接 {
            ? 局面[隣点] == 敵色 {
                ? 盤::ダメ数上限(局面, 路, 隣点, 2) == 1 { <~ 0 }
            }
        }

        @ 隣点 : 隣接 {
            ? 局面[隣点] == 色 {
                ? 盤::ダメ数上限(局面, 路, 隣点, 2) >= 2 { <~ 0 }
            }
        }

        <~ 2
    }

    合法(局面, 路, 起点, 色, コウ点) {
        <~ 判定(局面, 路, 起点, 色, コウ点) == 0
    }

    // 色 が打てる点をすべて。パスは常に打てるが、この一覧には
    // 決して入らない。パスは盤上の点ではないからである。
    //
    // EN: Every legal point for 色. Passing is always available and
    // is never in this list — a pass is not a point on the board.
    着手可能(局面, 路, 色, コウ点) {
        結果 = []
        総 = 路 * 路
        @ 点:1..総 {
            ? 局面[点] == 0 {
                ? 判定(局面, 路, 点, 色, コウ点) == 0 { 結果 = 結果 $+ 点 }
            }
        }
        <~ 結果
    }

    終局(連続パス) { <~ 連続パス >= 2 }

    // 拒否の符号を i18n の鍵へ写す。呼び手が文言を直に書くことは
    // 決してない。
    //
    // EN: Maps a rejection code to an i18n key, so the caller never
    // hard-codes a message.
    理由鍵(コード) {
        <~ ?? コード {
            1 => "報せ.占有"
            2 => "報せ.自殺"
            3 => "報せ.コウ"
            _  => ""
        }
    }
}
