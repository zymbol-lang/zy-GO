// ============================================================
// 核/規則.zy — 合法性と終局
//
// 盤.zy は石の振る舞いを知り、規則.zy はどの手が打てるかを知る。
// この分け方はコウのために要る。コウ禁止は今の局面についての
// 事実ではなく、対局の履歴についての事実なので、盤の側には
// 置けないのである。
//
// 判定() は呼び手の盤を決して書き換えない。写しの上で打つ。
// AI の輪の中で最も多く呼ばれる関数なので、一手が重いと
// 感じたら最初に見る場所でもある。
//
// EN: 核/規則.zy — legality and end of game
//
// 盤.zy knows how stones behave; 規則.zy knows which moves a
// player is allowed to make. The split matters for ko: a ko ban
// is a fact about the history of the game, not about the current
// position, so it cannot live in the board module.
//
// 判定() never mutates the caller's board — it plays on a copy.
// It is the most-called function in the AI loop, so it is also
// the first place to look when a turn feels slow.
// ============================================================

# .核_規則 {

    <# ./盤 => 盤

    #> {
        可
        禁_占有
        禁_自殺
        禁_コウ
        判定
        合法
        着手可能
        終局
        理由鍵
    }

    // 正の符号。盤.zy の 着手() に合わせてある。
    // EN: Positive codes, matching 盤.zy's 着手().
    可       := 0
    禁_占有  := 1
    禁_自殺  := 2
    禁_コウ  := 3

    // 合法なら 0、そうでなければ理由を返す。
    // EN: 0 when the move is legal, otherwise the reason.
    判定(局面, 路, 起点, 色, コウ点) {
        ? 起点 < 1 { <~ 1 }
        ? 起点 > 路 * 路 { <~ 1 }
        ? 局面[起点] <> 0 { <~ 1 }
        ? 起点 == コウ点 { <~ 3 }

        写 = 盤::複製(局面)
        取 = 0
        コウ = 0
        結果 = 盤::着手(写, 路, 起点, 色, 取, コウ)
        ? 結果 == 2 { <~ 2 }
        <~ 0
    }

    合法(局面, 路, 起点, 色, コウ点) {
        <~ 判定(局面, 路, 起点, 色, コウ点) == 0
    }

    // 色 が打てる点をすべて。パスは常に打てるが、この一覧には
    // 決して入らない。パスは盤上の点ではないからである。
    //
    // EN: Every legal point for 色. Passing is always available and
    // is never in this list — a pass is not a point on the board.
    着手可能(局面, 路, 色, コウ点) {
        結果 = []
        総 = 路 * 路
        @ 点:1..総 {
            ? 局面[点] == 0 {
                ? 判定(局面, 路, 点, 色, コウ点) == 0 { 結果 = 結果 $+ 点 }
            }
        }
        <~ 結果
    }

    終局(連続パス) { <~ 連続パス >= 2 }

    // 拒否の符号を i18n の鍵へ写す。呼び手が文言を直に書くことは
    // 決してない。
    //
    // EN: Maps a rejection code to an i18n key, so the caller never
    // hard-codes a message.
    理由鍵(コード) {
        <~ ?? コード {
            1 => "報せ.占有"
            2 => "報せ.自殺"
            3 => "報せ.コウ"
            _  => ""
        }
    }
}
