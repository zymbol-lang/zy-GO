// ============================================================
// 核/計算.zy — 目算
//
// 地と石の両方を数える中国式の計算を、日本語の語彙で示す。
// 一方の点数は盤上の自分の石に、自分の石が完全に囲んだ空点を
// 足したもの。白はそこにコミを加える。
//
// 日本式の地の計算ではなくこちらを選んだのは、プログラム
// だけで決着がつくからである。地の計算はどの石が死んでいるかを
// 両者がまず合意する必要があり、初級の AI にその交渉を
// 正直にこなす力は無い。セキも特別扱いなしで収まる。共有の
// ダメは両方の色に接するので誰の地にもならず、それがまさに
// 正しい答えである。
//
// EN: 核/計算.zy — scoring
//
// Area scoring (the Chinese method), presented with Japanese
// vocabulary. A player's score is their stones on the board plus
// the empty points their stones fully surround; White then adds
// komi.
//
// Area was chosen over Japanese territory scoring because it is
// decidable by the program alone: territory scoring needs both
// players to first agree which groups are dead, and a beginner
// AI cannot negotiate that honestly. Area also handles seki with
// no special case — a shared liberty borders both colours, so it
// counts for nobody, which is exactly the right answer.
// ============================================================

# .核_計算 {

    <# ./盤 => 盤

    #> {
        目算
        勝色
        差分
        領域図
    }

    // 空点の連結した一領域を塗り潰す。
    // 接触 は可変な組として使う二要素の配列である。
    //   接触[1] = この領域に黒石が接している
    //   接触[2] = この領域に白石が接している
    //
    // EN: Flood fill over one connected region of empty points.
    // 接触 is a two-slot array used as a mutable pair:
    // 接触[1] = a black stone borders this region,
    // 接触[2] = a white stone borders it.
    _空探索(局面, 路, 点, 印<~, 領域<~, 接触<~) {
        ? 局面[点] <> 0 {
            ? 局面[点] == 1 { 接触[1] = 1 } _ { 接触[2] = 1 }
            <~ 0
        }
        ? 印[点] == 1 { <~ 0 }
        印[点] = 1
        領域 = 領域 $+ 点
        @ 隣点 : 盤::隣(路, 点) { _空探索(局面, 路, 隣点, 印, 領域, 接触) }
        <~ 0
    }

    // 全体の勘定。呼び手が位置ではなく名前で読めるよう、
    // 名前付きの組を返す。
    //   黒石 白石 — 盤上の石
    //   黒地 白地 — 囲んだ空点
    //   黒合計 白合計 — 合計。白の側にはコミを含む
    //
    // EN: Full count. Returns a named tuple so the caller reads
    // fields by name rather than by position:
    //   黒石 白石 — stones on the board
    //   黒地 白地 — surrounded empty points
    //   黒合計 白合計 — totals, komi included on White's side
    目算(局面, 路, コミ) {
        黒石 = 盤::石数(局面, 1)
        白石 = 盤::石数(局面, 2)
        黒地 = 0
        白地 = 0

        印 = 盤::新規(路)
        総 = 路 * 路
        @ 点:1..総 {
            ? 局面[点] == 0 {
                ? 印[点] == 0 {
                    領域 = []
                    接触 = [0, 0]
                    _空探索(局面, 路, 点, 印, 領域, 接触)
                    広さ = 領域$#
                    ? 接触[1] == 1 {
                        ? 接触[2] == 0 { 黒地 = 黒地 + 広さ }
                    }
                    ? 接触[2] == 1 {
                        ? 接触[1] == 0 { 白地 = 白地 + 広さ }
                    }
                }
            }
        }

        // 合計は両方とも Float に寄せる。そうしないと点数の型が
        // 呼び手の渡したコミの型に左右される。Zymbol では Int と
        // Float の等値は厳密なので、Float の零に対して
        // 「合計 == 0」が黙って #0 を返す一方で、「>= 0」と
        // 「<= 0」はどちらも #1 を返してしまう。
        //
        // EN: Both totals are forced to Float. Otherwise the type of
        // a score would depend on the type of the komi the caller
        // passed — and Int/Float equality is strict in Zymbol, so
        // `合計 == 0` would silently answer #0 for a Float zero
        // while `>= 0` and `<= 0` both answer #1.
        黒合計 = ##.(黒石 + 黒地)
        白合計 = ##.(白石 + 白地) + ##.コミ

        <~ (
            黒石: 黒石,
            白石: 白石,
            黒地: 黒地,
            白地: 白地,
            黒合計: 黒合計,
            白合計: 白合計
        )
    }

    // 1 = 黒優勢、2 = 白優勢、0 = 持碁。
    // EN: 1 = black ahead, 2 = white ahead, 0 = 持碁 (jigo).
    勝色(結果) {
        ? 結果.黒合計 > 結果.白合計 { <~ 1 }
        ? 結果.白合計 > 結果.黒合計 { <~ 2 }
        <~ 0
    }

    // 差の絶対値。言語::結果文 のために。
    // EN: Absolute margin, for 言語::結果文.
    差分(結果) {
        ? 結果.黒合計 > 結果.白合計 { <~ 結果.黒合計 - 結果.白合計 }
        <~ 結果.白合計 - 結果.黒合計
    }

    // 点ごとの帰属。対局中の形勢表示に使う。
    //   0 中立 · 1 黒 · 2 白。石はそれ自身の色を保つ。
    //
    // EN: Per-point ownership, for the live estimate overlay:
    // 0 neutral · 1 black · 2 white. Stones keep their own colour.
    領域図(局面, 路) {
        図 = 盤::新規(路)
        印 = 盤::新規(路)
        総 = 路 * 路

        @ 点:1..総 {
            ? 局面[点] <> 0 { 図[点] = 局面[点] }
        }

        @ 点:1..総 {
            ? 局面[点] == 0 {
                ? 印[点] == 0 {
                    領域 = []
                    接触 = [0, 0]
                    _空探索(局面, 路, 点, 印, 領域, 接触)
                    主 = 0
                    ? 接触[1] == 1 {
                        ? 接触[2] == 0 { 主 = 1 }
                    }
                    ? 接触[2] == 1 {
                        ? 接触[1] == 0 { 主 = 2 }
                    }
                    ? 主 <> 0 {
                        @ 領点 : 領域 { 図[領点] = 主 }
                    }
                }
            }
        }
        <~ 図
    }
}
