// ============================================================
// 言語/中文.zy — 中国語 (zh)、簡体字
// 約束する関数: 語 · 路盤名 · 結果文 · 取石文
// 鍵は日本語。土台は 言語/日本語.zy にある。
//
// EN: 言語/中文.zy — Chinese locale (zh), simplified
// Interface contract: 語 · 路盤名 · 結果文 · 取石文
// The keys are Japanese; the base lives in 言語/日本語.zy.
// ============================================================

# .言語_中文 {

    #> { 語, 路盤名, 結果文, 取石文 }

    語(鍵) {
        <~ ?? 鍵 {
            "言語.名前"       => "中文"

            "品書.表題"       => "围棋"
            "品書.路盤"       => "棋盘"
            "品書.棋力"       => "棋力"
            "品書.手番"       => "执子"
            "品書.コミ"       => "贴目"
            "品書.主題"       => "主题"
            "品書.言語"       => "语言"
            "品書.案内"       => "↑↓ 选择   ←→ 修改   ↵ 开始"
            "品書.不可"       => "屏幕太窄"

            "棋力.1"          => "初级"
            "棋力.2"          => "中级"
            "棋力.3"          => "高级"

            "主題.石"         => "棋子"
            "主題.月"         => "月亮"
            "主題.字"         => "字符"

            "色.黒"           => "黑"
            "色.白"           => "白"
            "側.自分"         => "你"
            "側.機械"         => "AI"

            "区画.手番"       => "轮到"
            "区画.手数"       => "手数"
            "区画.アゲハマ"   => "提子"
            "区画.コミ"       => "贴目"
            "区画.最終手"     => "最后一手"
            "区画.目算"       => "形势判断"

            "報せ.占有"       => "该点已有棋子"
            "報せ.自殺"       => "不可自杀"
            "報せ.コウ"       => "因打劫禁着"
            "報せ.自分パス"   => "你虚手"
            "報せ.機械パス"   => "AI 虚手"
            "報せ.待った"     => "悔棋"
            "報せ.待った不可" => "无法再悔棋"
            "報せ.考慮中"     => "思考中…"
            "報せ.打つ手無し" => "无处可下 — 请虚手"
            "報せ.投了"       => "认输"

            "終局.表題"       => "终局"
            "終局.石"         => "子"
            "終局.地"         => "目"
            "終局.コミ"       => "贴目"
            "終局.合計"       => "合计"
            "終局.持碁"       => "和棋"
            "終局.結果"       => "结果"

            "操作.表題"       => "操作说明"
            "操作.移動"       => "移动光标"
            "操作.着手"       => "落子"
            "操作.パス"       => "虚手"
            "操作.待った"     => "悔棋"
            "操作.目算"       => "形势判断"
            "操作.主題切替"   => "切换主题"
            "操作.投了"       => "认输·退出"

            "端末.狭い"       => "终端太小"

            _                  => 鍵
        }
    }

    路盤名(路) {
        <~ ?? 路 {
            9  => "九路棋盘"
            13 => "十三路棋盘"
            19 => "十九路棋盘"
            _  => "{路}路棋盘"
        }
    }

    // 1.5 → "1目半" · 0.5 → "半目" · 3 → "3目"
    _目数(差) {
        整 = ##!差
        残 = 差 - ##.整
        ? 残 > 0.4 {
            ? 整 == 0 { <~ "半目" }
            <~ "{整}目半"
        }
        <~ "{整}目"
    }

    結果文(勝色, 差, 中押) {
        ? 中押 {
            ? 勝色 == 1 { <~ "黑中盘胜" }
            <~ "白中盘胜"
        }
        ? 差 == 0 { <~ "和棋" }
        目 = _目数(差)
        ? 勝色 == 1 { <~ "黑胜{目}" }
        <~ "白胜{目}"
    }

    取石文(数) { <~ "提{数}子" }
}
