// ============================================================
// 言語/한국어.zy — 韓国語 (ko)
// 約束する関数: 語 · 路盤名 · 結果文 · 取石文
// 鍵は日本語。土台は 言語/日本語.zy にある。
//
// EN: 言語/한국어.zy — Korean locale (ko)
// Interface contract: 語 · 路盤名 · 結果文 · 取石文
// The keys are Japanese; the base lives in 言語/日本語.zy.
// ============================================================

# .言語_한국어 {

    #> { 語, 路盤名, 結果文, 取石文 }

    語(鍵) {
        <~ ?? 鍵 {
            "言語.名前"       => "한국어"

            "品書.表題"       => "바둑"
            "品書.路盤"       => "판 크기"
            "品書.棋力"       => "기력"
            "品書.手番"       => "돌 선택"
            "品書.コミ"       => "덤"
            "品書.主題"       => "테마"
            "品書.言語"       => "언어"
            "品書.案内"       => "↑↓ 선택   ←→ 변경   ↵ 시작"
            "品書.不可"       => "화면이 좁음"

            "棋力.1"          => "초급"
            "棋力.2"          => "중급"
            "棋力.3"          => "고급"

            "主題.石"         => "돌"
            "主題.月"         => "달"
            "主題.字"         => "문자"

            "色.黒"           => "흑"
            "色.白"           => "백"
            "側.自分"         => "당신"
            "側.機械"         => "AI"

            "区画.手番"       => "차례"
            "区画.手数"       => "수순"
            "区画.アゲハマ"   => "사석"
            "区画.コミ"       => "덤"
            "区画.最終手"     => "마지막 수"
            "区画.目算"       => "형세 판단"

            "報せ.占有"       => "이미 돌이 있습니다"
            "報せ.自殺"       => "자살수는 둘 수 없습니다"
            "報せ.コウ"       => "패로 인해 착수 금지"
            "報せ.自分パス"   => "당신이 패스했습니다"
            "報せ.機械パス"   => "AI가 패스했습니다"
            "報せ.待った"     => "무름"
            "報せ.待った不可" => "더 이상 무를 수 없습니다"
            "報せ.考慮中"     => "생각 중…"
            "報せ.打つ手無し" => "둘 만한 곳이 없습니다 — 패스를"
            "報せ.投了"       => "기권"

            "終局.表題"       => "종국"
            "終局.石"         => "돌"
            "終局.地"         => "집"
            "終局.コミ"       => "덤"
            "終局.合計"       => "합계"
            "終局.持碁"       => "무승부"
            "終局.結果"       => "결과"

            "操作.表題"       => "조작법"
            "操作.移動"       => "커서 이동"
            "操作.着手"       => "착수"
            "操作.パス"       => "패스"
            "操作.待った"     => "무름"
            "操作.目算"       => "형세 판단"
            "操作.主題切替"   => "테마 변경"
            "操作.投了"       => "기권·종료"

            "端末.狭い"       => "터미널이 너무 작습니다"

            _                  => 鍵
        }
    }

    路盤名(路) { <~ "{路}줄 바둑판" }

    // 1.5 → "1집반" · 0.5 → "반집" · 3 → "3집"
    _집수(差) {
        整 = ##!差
        残 = 差 - ##.整
        ? 残 > 0.4 {
            ? 整 == 0 { <~ "반집" }
            <~ "{整}집반"
        }
        <~ "{整}집"
    }

    結果文(勝色, 差, 中押) {
        ? 中押 {
            ? 勝色 == 1 { <~ "흑 불계승" }
            <~ "백 불계승"
        }
        ? 差 == 0 { <~ "무승부" }
        집 = _집수(差)
        ? 勝色 == 1 { <~ "흑 {집}승" }
        <~ "백 {집}승"
    }

    取石文(数) { <~ "{数}점을 따냈습니다" }
}
