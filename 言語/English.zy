// ============================================================
// 言語/English.zy — 英語 (en)
// 約束する関数: 語 · 路盤名 · 結果文 · 取石文
// 鍵は日本語。土台は 言語/日本語.zy にある。
//
// EN: 言語/English.zy — English locale (en)
// Interface contract: 語 · 路盤名 · 結果文 · 取石文
// The keys are Japanese; the base lives in 言語/日本語.zy.
// ============================================================

# .言語_English {

    #> { 語, 路盤名, 結果文, 取石文 }

    語(鍵) {
        <~ ?? 鍵 {
            "言語.名前"       => "English"

            "品書.表題"       => "GO"
            "品書.路盤"       => "Board"
            "品書.棋力"       => "Level"
            "品書.手番"       => "Your side"
            "品書.コミ"       => "Komi"
            "品書.主題"       => "Theme"
            "品書.言語"       => "Language"
            "品書.案内"       => "↑↓ select   ←→ change   ↵ start"
            "品書.不可"       => "screen too small"

            "棋力.1"          => "Beginner"
            "棋力.2"          => "Intermediate"
            "棋力.3"          => "Advanced"

            "主題.石"         => "Stone"
            "主題.月"         => "Moon"
            "主題.字"         => "ASCII"

            "色.黒"           => "Black"
            "色.白"           => "White"
            "側.自分"         => "you"
            "側.機械"         => "AI"

            "区画.手番"       => "Turn"
            "区画.手数"       => "Moves"
            "区画.アゲハマ"   => "Captures"
            "区画.コミ"       => "Komi"
            "区画.最終手"     => "Last"
            "区画.目算"       => "Estimate"

            "報せ.占有"       => "there is already a stone there"
            "報せ.自殺"       => "suicide is not allowed"
            "報せ.コウ"       => "forbidden by ko"
            "報せ.自分パス"   => "you passed"
            "報せ.機械パス"   => "the AI passed"
            "報せ.待った"     => "undo"
            "報せ.待った不可" => "nothing left to undo"
            "報せ.考慮中"     => "thinking…"
            "報せ.打つ手無し" => "nothing useful left — press p to pass"
            "報せ.投了"       => "resigned"

            "終局.表題"       => "Game over"
            "終局.石"         => "Stones"
            "終局.地"         => "Territory"
            "終局.コミ"       => "Komi"
            "終局.合計"       => "Total"
            "終局.持碁"       => "Draw"
            "終局.結果"       => "Result"

            "操作.表題"       => "Controls"
            "操作.移動"       => "move cursor"
            "操作.着手"       => "place stone"
            "操作.パス"       => "pass"
            "操作.待った"     => "undo"
            "操作.目算"       => "score estimate"
            "操作.主題切替"   => "cycle theme"
            "操作.投了"       => "resign / quit"

            "端末.狭い"       => "terminal too small"

            _                  => 鍵
        }
    }

    路盤名(路) { <~ "{路}×{路}" }

    // 1.5 → "1.5 points" · 1 → "1 point"
    _点数(差) {
        整 = ##!差
        残 = 差 - ##.整
        ? 残 > 0.4 { <~ "{整}.5 points" }
        ? 整 == 1 { <~ "1 point" }
        <~ "{整} points"
    }

    結果文(勝色, 差, 中押) {
        ? 中押 {
            ? 勝色 == 1 { <~ "Black wins by resignation" }
            <~ "White wins by resignation"
        }
        ? 差 == 0 { <~ "Draw" }
        点 = _点数(差)
        ? 勝色 == 1 { <~ "Black wins by {点}" }
        <~ "White wins by {点}"
    }

    取石文(数) {
        ? 数 == 1 { <~ "captured 1 stone" }
        <~ "captured {数} stones"
    }
}
