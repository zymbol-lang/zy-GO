// ============================================================
// 集計.zy — すべての回を一つの答えにまとめる
//
//   zymbol run 集計.zy [場所] [es|en]
//
// 一回の走りは標本である。面白い数は回を足し合わせて初めて
// 現れ、しかも数として — 勝ちと局数として — 足さねばならない。
// 平均した百分率を足してはならない。summary.txt が行列を生のまま
// 収めているのはそのためであり、これが報告ではなく記録を読むのも
// そのためである。要約を書く前に途切れた回にも対局は残っており、
// その対局はやはり数に入る。
//
// これはまた、一回から言えたことを、記録されたすべての回に
// 突き合わせて確かめられるということでもある。四十局に模様を
// 読み込んでしまうことへの防ぎはそれしかない。
//
// EN: 集計.zy — aggregate every run into one answer
//
//   zymbol run 集計.zy [directory] [es|en]
//
// A single run is a sample. The interesting numbers only appear
// once runs are summed, and they must be summed as counts — wins
// and games — never as averaged percentages. That is why summary.txt
// stores the matrices raw, and why this reads the records rather
// than the reports: a run interrupted before it wrote its summary
// still has its games, and they still count.
//
// It also means a claim made from one run can be checked against
// every run ever recorded, which is the only defence against
// reading a pattern into forty games.
// ============================================================

<# ./表示/文字 => 文
<# ./標準/入出力 => 入出

既定 := "games"

訳(鍵, 西) {
    ? 西 {
        <~ ?? 鍵 {
            "title"   => "集計 — todas las tandas juntas"
            "dir"     => "directorio"
            "runs"    => "tandas"
            "games"   => "partidas"
            "skipped" => "sin terminar (sin summary)"
            "lvlhdr"  => "── nivel: victorias de la fila contra la columna ──"
            "perhdr"  => "── personalidad ──"
            "none"    => "no hay partidas que agregar"
            "beg"     => "Principiante"
            "int"     => "Intermedio"
            "adv"     => "Avanzado"
            "bal"     => "equilibrada"
            "off"     => "ofensiva"
            "def"     => "defensiva"
            "warn"    => "las celdas con menos de 30 partidas no dicen nada"
            _         => 鍵
        }
    }
    <~ ?? 鍵 {
        "title"   => "集計 — every run together"
        "dir"     => "directory"
        "runs"    => "runs"
        "games"   => "games"
        "skipped" => "unfinished (no summary)"
        "lvlhdr"  => "── level: row's wins against column ──"
        "perhdr"  => "── personality ──"
        "none"    => "no games to aggregate"
        "beg"     => "Beginner"
        "int"     => "Intermediate"
        "adv"     => "Advanced"
        "bal"     => "balanced"
        "off"     => "offensive"
        "def"     => "defensive"
        "warn"    => "cells under 30 games say nothing"
        _         => 鍵
    }
}

// 記録から "black level=2 personality=1" を取り出す。行頭 で
// 始まる行の中で、印 に続く数字を返す。
//
// EN: Pull "black level=2 personality=1" out of a record. Returns
// the digit that follows 印 within the line starting with 行頭.
_値(本文, 行頭, 印) {
    行 = ""
    @ 一行 : (本文 $/ '\n') {
        ? 行 == "" {
            ? (一行 $? 行頭) { 行 = 一行 }
        }
    }
    ? 行 == "" { <~ 0 - 1 }
    部 = 行 $/ 印
    ? (部$#) < 2 { <~ 0 - 1 }
    尾 = 部[2]
    // Zymbol の Char は比べられないので、数字は符号位置で見分ける。
    // 表示/文字.zy が幅を測るのに通るのと同じ道である。
    //
    // EN: Char is not comparable in Zymbol, so digits are recognised
    // by code point — the same route 表示/文字.zy takes to measure
    // width.
    数 = ""
    @ 文字 : 尾 {
        符号 = 文::符号点(文字)
        ? 符号 >= 48 && 符号 <= 57 {
            数 = "{数}{文字}"
        } _ {
            ? (数$#) > 0 { <~ #|数| }
        }
    }
    ? (数$#) > 0 { <~ #|数| }
    <~ 0 - 1
}

_勝者(本文) {
    @ 一行 : (本文 $/ '\n') {
        ? (一行 $? "result ") {
            ? (一行 $? "B+") { <~ 1 }
            ? (一行 $? "W+") { <~ 2 }
            <~ 0
        }
    }
    <~ 0 - 1
}

// ── 本体 ─────────────────────────────────────────────────────
// EN: main

>< 引数
場所 = 既定
西 = #0
// `@ 添字:1..数` は 数 が 1 未満のとき下へ数える。`1..0` は
// [1, 0] を歩く。降る範囲は文書化された機能だからである。
// だから空になりうる集まりを数えて回る輪には番人が要る。無ければ
// 通りすがりに空の配列の第一要素を引いてしまう。
//
// EN: `@ i:1..n` counts DOWN when n < 1 — `1..0` walks [1, 0],
// because descending ranges are a documented feature. So a count
// loop over a possibly-empty collection needs a guard, or it
// indexes element 1 of an empty array on the way past.
総引数 = 引数$#
? 総引数 > 0 {
    @ 添字:1..総引数 {
        引 = 引数[添字]
        ? 引 == "es" { 西 = #1 }
        _ {
            ? 引 <> "en" { 場所 = 引 }
        }
    }
}

勝表 = [0, 0, 0, 0, 0, 0, 0, 0, 0]
戦表 = [0, 0, 0, 0, 0, 0, 0, 0, 0]
性勝 = [0, 0, 0, 0, 0, 0, 0, 0, 0]
性戦 = [0, 0, 0, 0, 0, 0, 0, 0, 0]
総局 = 0
総走 = 0
未了 = 0

一覧 = 入出::一覧(場所)
? 一覧$! {
    >> "cannot read " 場所 ¶
} _ {
    @ 走 : 一覧 {
        道 = "{場所}/{走}"
        中身 = 入出::一覧(道)
        ? 中身$! { @> }

        // ただの file に対して 入出::一覧 は失敗しないので、そのまま
        // だと迷い込んだ README が空の回として数えられてしまう。
        // 回とは、実際に対局を含む場所のことである。
        //
        // EN: 入出::一覧 on a plain file does not fail, so a stray
        // README would otherwise be tallied as an empty run. A run is
        // a directory that actually contains games.
        完了 = #0
        棋数 = 0
        @ 名 : 中身 {
            ? 名 == "summary.txt" { 完了 = #1 }
            ? (名 $? ".kifu") { 棋数 = 棋数 + 1 }
        }
        ? 棋数 == 0 { @> }
        ? 完了 == #0 { 未了 = 未了 + 1 }
        総走 = 総走 + 1

        @ 名 : 中身 {
            ? (名 $? ".kifu") {
                本文 = 入出::読込("{道}/{名}")
                ? 本文$! { @> }

                黒級 = _値(本文, "black level", "level=")
                黒性 = _値(本文, "black level", "personality=")
                白級 = _値(本文, "white level", "level=")
                白性 = _値(本文, "white level", "personality=")
                勝 = _勝者(本文)

                ? 黒級 > 0 && 白級 > 0 && 勝 >= 0 {
                    総局 = 総局 + 1
                    黒枠 = (黒級 - 1) * 3 + 白級
                    白枠 = (白級 - 1) * 3 + 黒級
                    戦表[黒枠] = 戦表[黒枠] + 1
                    戦表[白枠] = 戦表[白枠] + 1
                    ? 勝 == 1 { 勝表[黒枠] = 勝表[黒枠] + 1 }
                    ? 勝 == 2 { 勝表[白枠] = 勝表[白枠] + 1 }

                    黒性枠 = 黒性 * 3 + 白性 + 1
                    白性枠 = 白性 * 3 + 黒性 + 1
                    性戦[黒性枠] = 性戦[黒性枠] + 1
                    性戦[白性枠] = 性戦[白性枠] + 1
                    ? 勝 == 1 { 性勝[黒性枠] = 性勝[黒性枠] + 1 }
                    ? 勝 == 2 { 性勝[白性枠] = 性勝[白性枠] + 1 }
                }
            }
        }
    }
}

題 = 訳("title", 西)
>> "═══ {題} ═══" ¶
札 = 文::右詰(訳("dir", 西), 26)
>> "  {札}{場所}" ¶
札 = 文::右詰(訳("runs", 西), 26)
>> "  {札}{総走}" ¶
札 = 文::右詰(訳("games", 西), 26)
>> "  {札}{総局}" ¶
? 未了 > 0 {
    札 = 文::右詰(訳("skipped", 西), 26)
    >> "  {札}{未了}" ¶
}
>> "" ¶

? 総局 == 0 {
    >> "  " (訳("none", 西)) ¶
} _ {
    級札 = [訳("beg", 西), 訳("int", 西), 訳("adv", 西)]
    性札 = [訳("bal", 西), 訳("off", 西), 訳("def", 西)]

    >> (訳("lvlhdr", 西)) ¶
    級甲 = 文::中央(級札[1], 14)
    級乙 = 文::中央(級札[2], 14)
    級丙 = 文::中央(級札[3], 14)
    詰 = 文::右詰("", 14)
    >> "  {詰}{級甲}{級乙}{級丙}" ¶
    @ 甲:1..3 {
        線 = 文::右詰(級札[甲], 14)
        @ 乙:1..3 {
            枠 = (甲 - 1) * 3 + 乙
            欄 = "—"
            ? 戦表[枠] > 0 {
                率 = 勝表[枠] * 100 / 戦表[枠]
                局数 = 戦表[枠]
                欄 = "{率}% /{局数}"
            }
            線 = "{線}{欄}"
            線 = 文::右詰(線, 14 + 乙 * 14)
        }
        >> "  " 線 ¶
    }
    >> "" ¶

    >> (訳("perhdr", 西)) ¶
    性甲 = 文::中央(性札[1], 14)
    性乙 = 文::中央(性札[2], 14)
    性丙 = 文::中央(性札[3], 14)
    >> "  {詰}{性甲}{性乙}{性丙}" ¶
    @ 甲:0..2 {
        線 = 文::右詰(性札[甲 + 1], 14)
        @ 乙:0..2 {
            枠 = 甲 * 3 + 乙 + 1
            欄 = "—"
            ? 性戦[枠] > 0 {
                率 = 性勝[枠] * 100 / 性戦[枠]
                局数 = 性戦[枠]
                欄 = "{率}% /{局数}"
            }
            線 = "{線}{欄}"
            線 = 文::右詰(線, 14 + (乙 + 1) * 14)
        }
        >> "  " 線 ¶
    }
    >> "" ¶
    >> "  " (訳("warn", 西)) ¶
}
